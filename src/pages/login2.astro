<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Sign in</title>

        <style>
            body {
                font-family: system-ui, sans-serif;
                max-width: 400px;
                margin: 80px auto;
                padding: 20px;
            }

            input,
            button {
                box-sizing: border-box;
                width: 100%;
                padding: 10px;
                margin-top: 10px;
                font: inherit;
            }

            button {
                cursor: pointer;
            }

            #user-info {
                margin-top: 20px;
                padding: 15px;
                background: #eee;
            }

            #error {
                color: #b00020;
                margin-top: 15px;
            }

            .hidden {
                display: none;
            }
        </style>
    </head>

    <body>
        <!--
            LOGGED OUT
        -->

        <div id="login">
            <h1>Sign in</h1>

            <button id="google-login">Sign in with Google</button>

            <button id="oidc-login">Sign in with Pocket ID</button>

            <hr />

            <input
                id="email"
                type="email"
                placeholder="Email"
                autocomplete="email"
            />

            <input
                id="password"
                type="password"
                placeholder="Password"
                autocomplete="current-password"
            />

            <button id="email-login">Sign in with email</button>

            <button id="create-account">Create account</button>

            <div id="error"></div>
        </div>

        <!--
            LOGGED IN
        -->

        <div id="logged-in" class="hidden">
            <h1>Welcome</h1>

            <div id="user-info"></div>

            <button id="logout">Sign out</button>
        </div>

        <!--
            Firebase Authentication SDK

            Identity Platform uses this SDK on the client side.
        -->

        <script type="module">
            import { initializeApp } from "https://www.gstatic.com/firebasejs/12.2.1/firebase-app.js";

            import {
                getAuth,
                GoogleAuthProvider,
                OAuthProvider,
                signInWithRedirect,
                getRedirectResult,
                signInWithEmailAndPassword,
                createUserWithEmailAndPassword,
                onAuthStateChanged,
                signOut,
            } from "https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";

            /*
             * ----------------------------------------------------
             * 1. INITIALIZE IDENTITY PLATFORM
             * ----------------------------------------------------
             */

            const firebaseConfig = {
                apiKey: "AIzaSyASIFTLz8371OOiQxz0b0lKuq9Oa4Cwv8Y",
                authDomain: "webauth.turinflow.com.br",

                // Use the values from your Identity Platform
                // web application configuration if provided.
                projectId: "YOUR_PROJECT_ID",
                appId: "YOUR_APP_ID",
            };

            const app = initializeApp(firebaseConfig);

            const auth = getAuth(app);

            /*
             * ----------------------------------------------------
             * 2. CONFIGURE THE IDENTITY PROVIDERS
             * ----------------------------------------------------
             */

            const googleProvider = new GoogleAuthProvider();

            /*
             * This ID must match the OIDC provider ID you
             * configured in Identity Platform.
             *
             * For example:
             *
             *   oidc.pocket-id
             */

            const pocketIdProvider = new OAuthProvider("oidc.pocket-id");

            /*
             * ----------------------------------------------------
             * 3. GOOGLE LOGIN
             * ----------------------------------------------------
             *
             * This starts a browser redirect.
             *
             * The browser leaves this page, goes through
             * Google's authentication flow, and eventually
             * returns to this application.
             */

            document
                .querySelector("#google-login")
                .addEventListener("click", async () => {
                    clearError();

                    try {
                        await signInWithRedirect(auth, googleProvider);
                    } catch (error) {
                        showError(error.message);
                    }
                });

            /*
             * ----------------------------------------------------
             * 4. POCKET ID LOGIN
             * ----------------------------------------------------
             *
             * Same mechanism as Google.
             *
             * Identity Platform handles the OIDC flow.
             */

            document
                .querySelector("#oidc-login")
                .addEventListener("click", async () => {
                    clearError();

                    try {
                        await signInWithRedirect(auth, pocketIdProvider);
                    } catch (error) {
                        showError(error.message);
                    }
                });

            /*
             * ----------------------------------------------------
             * 5. HANDLE THE RETURN FROM A REDIRECT
             * ----------------------------------------------------
             *
             * When Google or Pocket ID sends the browser
             * back to this page, Firebase checks whether
             * there is a pending redirect authentication.
             *
             * This works for either provider.
             */

            console.log("1. Auth page loaded");

            try {
                console.log("2. Checking redirect result...");

                const result = await getRedirectResult(auth);

                console.log("3. getRedirectResult completed:", result);

                if (result) {
                    console.log("4. Redirect authentication succeeded");
                    console.log("User:", result.user);
                } else {
                    console.log("4. No pending redirect");
                }
            } catch (error) {
                console.error("REDIRECT ERROR:", error);
                console.error("Code:", error.code);
                console.error("Message:", error.message);

                showError(`${error.code || "unknown"}: ${error.message}`);
            }

            try {
                const result = await getRedirectResult(auth);

                if (result) {
                    console.log("Authentication successful:", result.user);
                }
            } catch (error) {
                showError(error.message);
            }

            /*
             * ----------------------------------------------------
             * 6. EMAIL/PASSWORD LOGIN
             * ----------------------------------------------------
             */

            document
                .querySelector("#email-login")
                .addEventListener("click", async () => {
                    clearError();

                    const email = document.querySelector("#email").value;

                    const password = document.querySelector("#password").value;

                    try {
                        await signInWithEmailAndPassword(auth, email, password);
                    } catch (error) {
                        showError(error.message);
                    }
                });

            /*
             * ----------------------------------------------------
             * 7. CREATE ACCOUNT
             * ----------------------------------------------------
             */

            document
                .querySelector("#create-account")
                .addEventListener("click", async () => {
                    clearError();

                    const email = document.querySelector("#email").value;

                    const password = document.querySelector("#password").value;

                    try {
                        await createUserWithEmailAndPassword(
                            auth,
                            email,
                            password,
                        );
                    } catch (error) {
                        showError(error.message);
                    }
                });

            /*
             * ----------------------------------------------------
             * 8. WATCH AUTHENTICATION STATE
             * ----------------------------------------------------
             *
             * This is the part your application will rely on.
             *
             * Firebase calls this when:
             *
             *   - the page loads
             *   - the user signs in
             *   - the user signs out
             *   - the authentication state changes
             */

            onAuthStateChanged(auth, (user) => {
                const login = document.querySelector("#login");

                const loggedIn = document.querySelector("#logged-in");

                const userInfo = document.querySelector("#user-info");

                if (user) {
                    /*
                     * User is authenticated.
                     */

                    login.classList.add("hidden");

                    loggedIn.classList.remove("hidden");

                    userInfo.innerHTML = `
                        <strong>Email:</strong>
                        ${escapeHtml(user.email || "")}
                        <br>
                        <strong>User ID:</strong>
                        ${escapeHtml(user.uid)}
                    `;
                } else {
                    /*
                     * No authenticated user.
                     */

                    login.classList.remove("hidden");

                    loggedIn.classList.add("hidden");
                }
            });

            /*
             * ----------------------------------------------------
             * 9. LOG OUT
             * ----------------------------------------------------
             */

            document
                .querySelector("#logout")
                .addEventListener("click", async () => {
                    clearError();

                    try {
                        await signOut(auth);
                    } catch (error) {
                        showError(error.message);
                    }
                });

            /*
             * ----------------------------------------------------
             * HELPERS
             * ----------------------------------------------------
             */

            function showError(message) {
                document.querySelector("#error").textContent = message;
            }

            function clearError() {
                document.querySelector("#error").textContent = "";
            }

            function escapeHtml(value) {
                return value
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }
        </script>
    </body>
</html>
```
