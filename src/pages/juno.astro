<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Turin: Trânsito Agora em São Paulo</title>
        <meta
            name="description"
            content="O Turin mostra a você o trânsito em São Paulo. Veja os locais de congestionamento aqui."
        />
        <link rel="canonical" href="https://turinflow.com.br/juno" />

        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/maplibre-gl@6.16.0/dist/maplibre-gl.css"
        />
    </head>

    <body>
        <div id="map"></div>

        <style is:global>
            html,
            body,
            #map {
                height: 100%;
                margin: 0;
            }
        </style>

        <script>
            import * as maplibregl from "https://cdn.jsdelivr.net/npm/maplibre-gl@6.16.0/+esm";
            import { Protocol } from "https://cdn.jsdelivr.net/npm/pmtiles@4.5.0/+esm";

            // Alphaville, centred. Kept small on purpose: maxBounds follows it, so
            // a tight box also pins the viewport.
            const bbox = {
                west: -46.90926270487596,
                south: -23.523753431774985,
                east: -46.796531591361624,
                north: -23.43226388087442,
            };

            const zoom = 15;
            const minZoom = 4;

            // The archive is built with --maxzoom=15. The source declares that
            // truth; the camera may go a little deeper and overzoom z15 tiles.
            const tileMaxZoom = 14;
            const maxZoom = 18;
            const trafficOpacity = 0.6;

            const center = ["-46.85289714811879", "-23.4780086563247"];

            const protocol = new Protocol();
            maplibregl.addProtocol("pmtiles", protocol.tile);

            // Palette. The tileset is a Planetiler generate-custom build from
            // turin2.yaml (a fork of Planetiler's Shortbread sample), so every
            // colour below is applied by the explicit layers in turinLayers().
            // There is no @protomaps/basemaps here on purpose: that package styles
            // the Protomaps Basemap schema (earth/landuse/roads/places), which this
            // archive does not contain.
            const c = {
                // LAND
                background: "#f4f2ec",
                land: {
                    wood: "#d2e1cc",
                    forest: "#d2e1cc",
                    park: "#dce7d7",
                    garden: "#dce7d7",
                    grass: "#e3ebdf",
                    meadow: "#e5e9d9",
                    residential: "#f0eee8",
                    retail: "#efeae2",
                    commercial: "#efeae2",
                    industrial: "#e7e1d7",
                    cemetery: "#e2e6dc",
                    sand: "#eee4d2",
                    beach: "#eee4d2",
                    farmland: "#eef0e4",
                    ice: "#e8f0f2",
                     residentialEdge: "#dedbd1",
                },
                natural: "#e5e9d9",
                urban: "#e9e4da",

                // WATER
                water: "#b7d5e5",
                waterLabel: "#527b91",

                // URBAN
                buildings: "#d8d5cf",

                // ROADS: casing first, fill on top
                casingMinor: "#e2ded5",
                minor: "#fffefa",
                casingMajor: "#dfc9a6",
                major: "#f0dfc1",
                casingHighway: "#c99b5c",
                highway: "#e8b66e",
                link: "#efd3a5",
                other: "#f5f2eb",
                rail: "#b5a9a0",
                boundary: "#c7c2b7",

                // RAIL AND EDGES
                railway: "#b5a9a0",
                barrier: "#b9b2a6",
                hedge: "#c3cfb4",

                // LABELS
                label: "#354957",
                labelSoft: "#536671",
                labelRoad: "#495760",
                halo: "#f4f2ec",
            };

            const sources = {
                turin: {
                    type: "vector",
                    // The pmtiles:// scheme routes through the Protocol registered
                    // above so only byte ranges are fetched, never the whole file.
                    url: "pmtiles://https://maps.turinflow.com.br/sp3.pmtiles",
                    maxzoom: 14,
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                },
                traffic: {
                    type: "raster",
                    tiles: [
                        "https://tiles.vtinc.com.br/tile?x={x}&y={y}&z={z}",
                    ],
                    tileSize: 256,
                    maxzoom: 20,
                    attribution: "Traffic &copy; TomTom",
                },
            };

            const roadClasses = {
                minor: [
                    "residential",
                    "unclassified",
                    "service",
                    "living_street",
                    "track",
                    "path",
                ],
                major: ["tertiary", "secondary", "primary", "minor"],
                highway: ["motorway", "trunk"],
                path: ["pedestrian", "footway", "cycleway", "steps"],
            };

            const basemapStyle = {
                version: 8,
                glyphs: "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
                sources,
                // Back-to-front. Labels come last so they sit above the traffic
                // raster and remain readable through it.
                layers: [
                    ...fillLayers(),
                    ...lineLayers(),
                    ...labelLayers(),
                    {
                        id: "traffic",
                        type: "raster",
                        source: "traffic",
                        paint: {
                            "raster-opacity": trafficOpacity,
                            "raster-contrast": 0.25,
                            "raster-saturation": 0.35,
                            "raster-resampling": "linear",
                        },
                    },
                    ...labelLayers(true),
                ],
            };

            function fillLayers() {
                return [
                    {
                        id: "background",
                        type: "background",
                        paint: { "background-color": c.background },
                    },

                    {
                        id: "landuse",
                        type: "fill",
                        source: "turin",
                        "source-layer": "landuse",
                        paint: {
                            "fill-color": [
                                "match",
                                ["get", "class"],
                                "residential",
                                c.land.residential,
                                "commercial",
                                c.land.commercial,
                                "retail",
                                c.land.retail,
                                "industrial",
                                c.land.industrial,
                                "cemetery",
                                c.land.cemetery,
                                "park",
                                c.land.park,
                                "garden",
                                c.land.garden,
                                "grass",
                                c.land.grass,
                                "meadow",
                                c.land.meadow,
                                "sand",
                                c.land.sand,
                                "beach",
                                c.land.beach,
                                "hospital",
                                c.urban,
                                "school",
                                c.urban,
                                c.urban,
                            ],
                        },
                    },

                    {
                        id: "landcover",
                        type: "fill",
                        source: "turin",
                        "source-layer": "landcover",
                        paint: {
                            "fill-color": [
                                "match",
                                ["get", "class"],
                                "wood",
                                c.land.wood,
                                "forest",
                                c.land.forest,
                                "grass",
                                c.land.grass,
                                "farmland",
                                c.land.farmland,
                                "ice",
                                c.land.ice,
                                c.natural,
                            ],
                            "fill-opacity": 0.6,
                        },
                    },
                    {
                        // Faux walls. The tilemaker OpenMapTiles profile emits no
                        // barrier geometry at all, so the gated-community walls
                        // seen around São Paulo are not in the archive. Drawing
                        // the residential *outline* reads the same way: it traces
                        // the wall wherever the wall is what separates the
                        // condominium from the street.
                        //
                        // Line width is off in Mercator units (it cannot be
                        // otherwise on a polygon outline), so it is deliberately
                        // thin: as an outline the stroke straddles both sides of
                        // the boundary and would otherwise read as thicker than
                        // the road casing beside it.
                        id: "residential_edge",
                        type: "line",
                        source: "turin",
                        "source-layer": "landuse",
                        minzoom: 13,
                        filter: ["==", ["get", "class"], "residential"],
                        paint: {
                            "line-color": c.land.residentialEdge,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                13,
                                0.5,
                                18,
                                1.6,
                            ],
                            "line-opacity": 0.7,
                        },
                    },
                    {
                        // OpenMapTiles splits urban fill into `aeroway` (the
                        // pavement) and `park` (the polygons); `park` doubles
                        // as the OSM natural=wood / landuse=forest carrier.
                        id: "aeroway",
                        type: "fill",
                        source: "turin",
                        "source-layer": "aeroway",
                        filter: ["==", ["get", "class"], "aerodrome"],
                        paint: { "fill-color": "#e7e3da" },
                    },
                    {
                        id: "water",
                        type: "fill",
                        source: "turin",
                        "source-layer": "water",
                        paint: { "fill-color": c.water },
                    },
                    {
                        id: "park",
                        type: "fill",
                        source: "turin",
                        "source-layer": "park",
                        paint: {
                            "fill-color": [
                                "match",
                                ["get", "class"],
                                "wood",
                                c.land.wood,
                                "forest",
                                c.land.forest,
                                "grass",
                                c.land.grass,
                                "garden",
                                c.land.garden,
                                "pitch",
                                "#d9e5d4",
                                c.land.park,
                            ],
                            "fill-opacity": 0.85,
                        },
                    },
                    {
                        id: "building",
                        type: "fill",
                        source: "turin",
                        "source-layer": "building",
                        paint: { "fill-color": c.buildings },
                    },
                ];
            }

            function lineLayers() {
                return [
                    {
                        id: "waterway",
                        type: "line",
                        source: "turin",
                        "source-layer": "waterway",
                        paint: {
                            "line-color": c.water,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                10,
                                0.5,
                                16,
                                4,
                            ],
                        },
                    },
                    {
                        id: "road_service",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        filter: [
                            "in",
                            ["get", "class"],
                            ["literal", ["service", "track", "path"]],
                        ],
                        layout: { "line-cap": "round", "line-join": "round" },
                        paint: {
                            "line-color": c.other,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                13,
                                0.4,
                                18,
                                4,
                            ],
                        },
                    },
                    {
                        id: "road_minor",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        minzoom: 10,
                        filter: [
                            "in",
                            ["get", "class"],
                            ["literal", roadClasses.minor],
                        ],
                        // Butt caps are the default and they make a dead end
                        // look like a road that simply stops. Round caps turn it
                        // into the turning circle a cul-de-sac actually has, and
                        // round joins stop hairpins from notching. Both are
                        // LAYOUT properties: in `paint` the style validator
                        // rejects them with "unknown property".
                        layout: { "line-cap": "round", "line-join": "round" },
                        paint: {
                            "line-color": c.minor,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                12,
                                0.5,
                                16,
                                3,
                                18,
                                8,
                            ],
                        },
                    },
                    {
                        // Casing under the major fill. Two layers rather than
                        // a blurred line-width trick so the edges stay crisp.
                        id: "road_major_casing",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        minzoom: 8,
                        filter: [
                            "in",
                            ["get", "class"],
                            ["literal", roadClasses.major],
                        ],
                        layout: { "line-cap": "round", "line-join": "round" },
                        paint: {
                            "line-color": c.casingMajor,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                8,
                                0.8,
                                14,
                                4.8,
                                18,
                                17,
                            ],
                        },
                    },
                    {
                        id: "road_major",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        minzoom: 8,
                        filter: [
                            "in",
                            ["get", "class"],
                            ["literal", roadClasses.major],
                        ],
                        layout: { "line-cap": "round", "line-join": "round" },
                        paint: {
                            "line-color": c.major,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                8,
                                0.5,
                                14,
                                4,
                                18,
                                14,
                            ],
                        },
                    },
                    {
                        id: "road_highway_casing",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        minzoom: 5,
                        filter: [
                            "in",
                            ["get", "class"],
                            ["literal", roadClasses.highway],
                        ],
                        layout: { "line-cap": "round", "line-join": "round" },
                        paint: {
                            "line-color": c.casingHighway,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                6,
                                1.5,
                                12,
                                4,
                                18,
                                19,
                            ],
                        },
                    },
                    {
                        id: "road_highway",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        minzoom: 5,
                        filter: [
                            "in",
                            ["get", "class"],
                            ["literal", roadClasses.highway],
                        ],
                        layout: { "line-cap": "round", "line-join": "round" },
                        paint: {
                            "line-color": c.highway,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                6,
                                1,
                                12,
                                3,
                                18,
                                16,
                            ],
                        },
                    },
                    {
                        id: "railway",
                        type: "line",
                        source: "turin",
                        "source-layer": "transportation",
                        minzoom: 9,
                        filter: ["==", ["get", "class"], "rail"],
                        paint: {
                            "line-color": c.rail,
                            "line-dasharray": [0.3, 0.75],
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                10,
                                0.5,
                                18,
                                6,
                            ],
                        },
                    },
                    {
                        // Admin boundaries only; maritime ones would draw a
                        // line out to sea with nothing on either side.
                        id: "boundary",
                        type: "line",
                        source: "turin",
                        "source-layer": "boundary",
                        filter: [
                            "all",
                            ["!=", ["get", "maritime"], 1],
                            ["<=", ["get", "admin_level"], 6],
                        ],
                        paint: {
                            "line-color": c.boundary,
                            "line-width": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                4,
                                0.6,
                                12,
                                1.2,
                            ],
                            "line-dasharray": [2, 1],
                        },
                    },
                    {
                        id: "aeroway_runway",
                        type: "line",
                        source: "turin",
                        "source-layer": "aeroway",
                        minzoom: 11,
                        filter: ["==", ["get", "class"], "runway"],
                        paint: {
                            "line-color": "#cfcac1",
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                11,
                                0.5,
                                18,
                                8,
                            ],
                        },
                    },
                ];
            }

            function labelLayers(lifted = false) {
                const prefix = lifted ? "top_" : "";
                return [
                    {
                        id: `${prefix}place_label`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "place",
                        minzoom: 4,

                        filter: [
                            "all",
                            ["has", "name:latin"],
                            [
                                "in",
                                ["get", "class"],
                                [
                                    "literal",
                                    [
                                        "continent",
                                        "country",
                                        "state",
                                        "city",
                                        "town",
                                    ],
                                ],
                            ],
                        ],
                        layout: {
                            "text-field": ["get", "name:latin"],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                4,
                                [
                                    "match",
                                    ["get", "class"],
                                    "city",
                                    14,
                                    "town",
                                    12,
                                    10,
                                ],
                                8,
                                13,
                                12,
                                12,
                            ],
                            // One placement per feature keeps a long name from
                            // tiling itself along the viewport.
                            "symbol-placement": "point",
                            "text-max-width": 8,
                        },
                        paint: {
                            "text-color": c.label,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1.2,
                        },
                    },
                    {
                        // Neighbourhoods, back but on a leash. They are the
                        // thing that made z11-13 unreadable: a metro area has
                        // hundreds of them and they all compete for the same
                        // pixels as street names. Starting them at z12 and
                        // ranking them below the street layer (drawn earlier,
                        // so a collision goes to the street) keeps the useful
                        // ones — Pinheiros, Moema, Butantã — without the wall.
                        //
                        // `symbol-sort-key` uses OSM's own `rank`, which the
                        // tilemaker profile derives from population, so bigger,
                        // better-known districts win ties.
                        id: `${prefix}neighbourhood_label`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "place",
                        minzoom: 12,
                        filter: [
                            "all",
                            ["has", "name:latin"],
                            [
                                "in",
                                ["get", "class"],
                                [
                                    "literal",
                                    ["suburb", "quarter", "neighbourhood"],
                                ],
                            ],
                        ],
                        layout: {
                            "text-field": ["get", "name:latin"],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                12,
                                10,
                                15,
                                11,
                            ],
                            "text-transform": "uppercase",
                            "text-letter-spacing": 0.1,
                            "text-max-width": 7,
                            "symbol-sort-key": [
                                "to-number",
                                ["get", "rank"],
                                99,
                            ],
                        },
                        paint: {
                            "text-color": c.labelSoft,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1.1,
                        },
                    },
                    {
                        id: `${prefix}street_label`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "transportation_name",
                        minzoom: 12,
                        // Only the street classes worth naming. Service roads,
                        // paths and tracks have names in OSM and none of them
                        // help you read a traffic map.
                        filter: [
                            "in",
                            ["get", "class"],
                            [
                                "literal",
                                [
                                    "motorway",
                                    "trunk",
                                    "primary",
                                    "secondary",
                                    "tertiary",
                                    "minor",
                                    "street",
                                    "rail",
                                ],
                            ],
                        ],
                        layout: {
                            "symbol-placement": "line",
                            "text-field": [
                                "coalesce",
                                ["get", "name:latin"],
                                ["get", "ref"],
                            ],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                13,
                                10,
                                17,
                                12,
                            ],
                            // Labels repeat along the line by default; one
                            // repetition per street is enough to identify it.
                            "symbol-spacing": 600,
                            "text-max-angle": 35,
                        },
                        paint: {
                            "text-color": c.labelRoad,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1,
                        },
                    },
                    // No water_name layer: naming the Tietê and the Pinheiros
                    // adds ink without adding information on a traffic map, and
                    // a linear river label cuts across the road network it is
                    // supposed to sit beside.
                    {
                        // Named airports, which is what `aerodrome_label`
                        // carries: Congonhas, Guarulhos, Viracopos. Size from
                        // the IATA/ICAO size class rather than zoom alone.
                        id: `${prefix}aerodrome_label`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "aerodrome_label",
                        minzoom: 8,
                        filter: ["has", "name:latin"],
                        layout: {
                            "text-field": [
                                "coalesce",
                                ["get", "name:latin"],
                                ["get", "iata"],
                                ["get", "icao"],
                            ],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": 11,
                            "text-offset": [0, 1],
                        },
                        paint: {
                            "text-color": c.labelSoft,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1,
                        },
                    },
                    {
                        // The peaks that make the state worth covering at all:
                        // Pico do Jaraguá down south through Pedra do Baú.
                        // `ele` is metres.
                        id: `${prefix}mountain_peak`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "mountain_peak",
                        minzoom: 11,
                        // Peaks are texture, not information: keep the ones with
                        // a real summit and drop every saddle and ridge that
                        // happens to be tagged natural=peak.
                        filter: [
                            "all",
                            ["has", "name:latin"],
                            [
                                "all",
                                ["has", "ele"],
                                [">=", ["get", "ele"], 800],
                            ],
                        ],
                        layout: {
                            "text-field": [
                                "case",
                                ["has", "ele"],
                                [
                                    "concat",
                                    ["get", "name:latin"],
                                    "\n",
                                    ["to-string", ["get", "ele"]],
                                    " m",
                                ],
                                ["get", "name:latin"],
                            ],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": 10,
                            "text-anchor": "top",
                        },
                        paint: {
                            "text-color": c.labelSoft,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1,
                        },
                    },
                    {
                        // Address numbers, only where buildings exist to sit
                        // them on. The 0.6 opacity keeps a dense grid legible.
                        id: `${prefix}housenumber`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "housenumber",
                        minzoom: 17,
                        layout: {
                            "text-field": ["get", "housenumber"],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": 9,
                        },
                        paint: {
                            "text-color": c.labelSoft,
                            "text-opacity": 0.6,
                            "text-halo-color": c.halo,
                            "text-halo-width": 0.8,
                        },
                    },
                    {
                        id: `${prefix}schools`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "poi",
                        minzoom: 13,
                        filter: [
                            "all",
                            ["has", "name:latin"],
                            // The profile maps amenity=school to class "school"; universities and
                            // colleges are separate classes because OpenMapTiles keeps them apart.
                            [
                                "in",
                                ["get", "class"],
                                ["literal", ["school", "college"]],
                            ],
                        ],
                        layout: {
