<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Turin: Trânsito Agora em São Paulo</title>
        <meta
            name="description"
            content="O Turin mostra a você o trânsito em São Paulo. Veja os locais de congestionamento aqui."
        />
        <link rel="canonical" href="https://turinflow.com.br/juno" />

        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/maplibre-gl@6.16.0/dist/maplibre-gl.css"
        />
    </head>

    <body>
        <div id="map"></div>

        <style is:global>
            html,
            body,
            #map {
                height: 100%;
                margin: 0;
            }
        </style>

        <script>
            import * as maplibregl from "https://cdn.jsdelivr.net/npm/maplibre-gl@6.16.0/+esm";
            import { Protocol } from "https://cdn.jsdelivr.net/npm/pmtiles@4.5.0/+esm";
            import {
                LIGHT,
                layers,
            } from "https://cdn.jsdelivr.net/npm/@protomaps/basemaps@5.7.2/+esm";

            // São Paulo metropolitan region, roughly: Jundiaí to São José dos
            // Campos, and Sorocaba up to the Serra da Cantareira.

            const bbox = {
                west: -46.90926270487596,
                south: -23.523753431774985,
                east: -46.796531591361624,
                north: -23.43226388087442,
            };

            const zoom = 15;
            const maxZoom = 20;
            const minZoom = 8;
            const trafficOpacity = 0.6;

            const center = [
                (bbox.west + bbox.east) / 2,
                (bbox.south + bbox.north) / 2,
            ];

            const protocol = new Protocol();
            maplibregl.addProtocol("pmtiles", protocol.tile);

            // Start from the stock "light" flavor and override only what Turin
            // needs, so upstream improvements still come through.
            
            const flavor = {
    ...LIGHT,

    // LAND
    background: "#f4f2ec",
    earth: "#f4f2ec",
    sand: "#eee4d2",
    beach: "#e9dfc9",

    // NATURE
    park_a: "#e3ebdf",
    park_b: "#dce7d7",
    wood_a: "#d2e1cc",
    wood_b: "#c8dbc1",
    scrub_a: "#e5e9d9",
    scrub_b: "#dce3d1",
    glacier: "#e8f0f2",

    // WATER
    water: "#b7d5e5",
    ocean_label: "#527b91",

    // BUILDINGS AND URBAN AREAS
    buildings: "#d8d5cf",
    industrial: "#e7e1d7",
    aerodrome: "#e8e4dc",
    hospital: "#f0e0dc",
    school: "#eee7d7",

    // LOCAL ROADS
    minor_a: "#fffefa",
    minor_b: "#f8f7f2",
    minor_casing: "#e2ded5",
    minor_service: "#f2efe8",
    minor_service_casing: "#e4dfd5",

    // ARTERIAL ROADS
    major: "#f0dfc1",
    major_casing_early: "#dfc9a6",
    major_casing_late: "#e6d5bb",

    // HIGHWAYS
    highway: "#e8b66e",
    highway_casing_early: "#c99b5c",
    highway_casing_late: "#d6aa70",

    // CONNECTORS AND OTHER ROADS
    link: "#efd3a5",
    link_casing: "#d9bd98",
    other: "#f5f2eb",
    pedestrian: "#eee8dc",
    pier: "#e3d9c8",

    // BRIDGES
    bridges_highway: "#e8b66e",
    bridges_highway_casing: "#c99b5c",
    bridges_major: "#f0dfc1",
    bridges_major_casing: "#dfc9a6",
    bridges_minor: "#fffefa",
    bridges_minor_casing: "#e2ded5",
    bridges_link: "#efd3a5",
    bridges_link_casing: "#d9bd98",
    bridges_other: "#f5f2eb",
    bridges_other_casing: "#e2ded5",

    // TUNNELS
    tunnel_highway: "#dfb77f",
    tunnel_highway_casing: "#c6a477",
    tunnel_major: "#e7d8bd",
    tunnel_major_casing: "#d5c5aa",
    tunnel_minor: "#efeee8",
    tunnel_minor_casing: "#d9d6cd",
    tunnel_link: "#e8d1ae",
    tunnel_link_casing: "#d2bd9e",
    tunnel_other: "#eeece5",
    tunnel_other_casing: "#d9d6cd",

    // RAILWAYS AND BOUNDARIES
    railway: "#b5a9a0",
    boundaries: "#c7c2b7",
    military: "#e8ddd0",
    zoo: "#e1eadb",
    runway: "#e5e0d6",

    // LABELS
    city_label: "#354957",
    subplace_label: "#536671",
    state_label: "#536671",
    country_label: "#354957",
    roads_label_major: "#495760",
    roads_label_minor: "#64717a",

    // LABEL HALOS
    city_label_halo: "#f4f2ec",
    subplace_label_halo: "#f4f2ec",
    state_label_halo: "#f4f2ec",
    roads_label_major_halo: "#f4f2ec",
    roads_label_minor_halo: "#f4f2ec",
    address_label: "#53616a",
    address_label_halo: "#f4f2ec",
            };

            
            const sources = {
                protomaps: {
                    type: "vector",
                    // The pmtiles:// scheme routes through the Protocol registered
                    // above so only byte ranges are fetched, never the whole file.
                    url: "pmtiles://https://maps.turinflow.com.br/sp.pmtiles",
                    maxzoom: 15,
                    attribution:
                        '<a href="https://protomaps.com">Protomaps</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                },
                traffic: {
                    type: "raster",
                    tiles: [
                        "https://tiles.vtinc.com.br/tile?x={x}&y={y}&z={z}",
                    ],
                    tileSize: 256,
                    maxzoom: maxZoom,
                    attribution: "Traffic &copy; TomTom",
                },
            };

            const basemapStyle = {
                version: 8,
                glyphs: "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
                sprite: "https://protomaps.github.io/basemaps-assets/sprites/v4/light",
                sources,
                layers: [
                    ...layers("protomaps", flavor, { lang: "pt" }),
                    // Turin's own overlays go in as ordinary style layers, which
                    // keeps them below the labels instead of on top of them.
                    ...turinLayers(),
                ],
            };

            // Everything here renders above the basemap fills and roads but below
            // the labels, so street names stay readable. These need `sources` to
            // be declared up front too, otherwise MapLibre aborts the style.
            function turinLayers() {
                return [
                    {
                        id: "traffic",
                        type: "raster",
                        source: "traffic",
                        paint: { "raster-opacity": trafficOpacity },
                    },
                ];
            }

            const map = new maplibregl.Map({
                container: "map",
                style: basemapStyle,
                center,
                zoom,
                minZoom,
                maxZoom,
                maxBounds: [
                    [bbox.west, bbox.south],
                    [bbox.east, bbox.north],
                ],
                attributionControl: {
                    compact: true,
                    customAttribution: "Turin Flow",
                },
            });
        </script>
    </body>
</html>
