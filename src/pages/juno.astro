<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Turin: Trânsito Agora em São Paulo</title>
        <meta
            name="description"
            content="O Turin mostra a você o trânsito em São Paulo. Veja os locais de congestionamento aqui."
        />
        <link rel="canonical" href="https://turinflow.com.br/juno" />

        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/maplibre-gl@6.16.0/dist/maplibre-gl.css"
        />
    </head>

    <body>
        <div id="map"></div>

        <style is:global>
            html,
            body,
            #map {
                height: 100%;
                margin: 0;
            }
        </style>

        <script>
            import * as maplibregl from "https://cdn.jsdelivr.net/npm/maplibre-gl@6.16.0/+esm";
            import { Protocol } from "https://cdn.jsdelivr.net/npm/pmtiles@4.5.0/+esm";

            // Alphaville, centred. Kept small on purpose: maxBounds follows it, so
            // a tight box also pins the viewport.
            const bbox = {
                west: -46.90926270487596,
                south: -23.523753431774985,
                east: -46.796531591361624,
                north: -23.43226388087442,
            };

            const zoom = 15;
            const minZoom = 8;

            // The archive is built with --maxzoom=15. The source declares that
            // truth; the camera may go a little deeper and overzoom z15 tiles.
            const tileMaxZoom = 15;
            const maxZoom = 18;
            const trafficOpacity = 0.6;

            const center = [
                (bbox.west + bbox.east) / 2,
                (bbox.south + bbox.north) / 2,
            ];

            const protocol = new Protocol();
            maplibregl.addProtocol("pmtiles", protocol.tile);

            // Palette. The tileset is a Planetiler generate-custom build from
            // turin2.yaml (a fork of Planetiler's Shortbread sample), so every
            // colour below is applied by the explicit layers in turinLayers().
            // There is no @protomaps/basemaps here on purpose: that package styles
            // the Protomaps Basemap schema (earth/landuse/roads/places), which this
            // archive does not contain.
            const c = {
                // LAND
                background: "#f4f2ec",
                land: {
                    forest: "#d2e1cc",
                    wood: "#d2e1cc",
                    grass: "#e3ebdf",
                    park: "#dce7d7",
                    garden: "#dce7d7",
                    meadow: "#e5e9d9",
                    scrub: "#e5e9d9",
                    heath: "#e5e9d9",
                    wetland: "#cfe0da",
                    farming: "#eef0e4",
                    residential: "#f0eee8",
                    industrial: "#e7e1d7",
                    sand: "#eee4d2",
                    glacier: "#e8f0f2",
                },
                natural: "#e5e9d9",

                // WATER
                water: "#b7d5e5",
                waterLabel: "#527b91",

                // URBAN
                buildings: "#d8d5cf",

                // ROADS: casing first, fill on top
                casingMinor: "#e2ded5",
                minor: "#fffefa",
                casingMajor: "#dfc9a6",
                major: "#f0dfc1",
                casingHighway: "#c99b5c",
                highway: "#e8b66e",
                link: "#efd3a5",
                other: "#f5f2eb",

                // RAIL AND EDGES
                railway: "#b5a9a0",
                boundary: "#c7c2b7",
                barrier: "#b9b2a6",
                hedge: "#c3cfb4",

                // LABELS
                label: "#354957",
                labelSoft: "#536671",
                labelRoad: "#495760",
                halo: "#f4f2ec",
            };

            const sources = {
                turin: {
                    type: "vector",
                    // The pmtiles:// scheme routes through the Protocol registered
                    // above so only byte ranges are fetched, never the whole file.
                    url: "pmtiles://https://maps.turinflow.com.br/sp2.pmtiles",
                    maxzoom: 15,
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                },
                traffic: {
                    type: "raster",
                    tiles: [
                        "https://tiles.vtinc.com.br/tile?x={x}&y={y}&z={z}",
                    ],
                    tileSize: 256,
                    maxzoom: tileMaxZoom,
                    attribution: "Traffic &copy; TomTom",
                },
            };

            const basemapStyle = {
                version: 8,
                glyphs: "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
                sources,
                // Back-to-front. Labels come last so they sit above the traffic
                // raster and remain readable through it.
                layers: [
                    ...fillLayers(),
                    ...lineLayers(),
                    ...labelLayers(),
                    {
                        id: "traffic",
                        type: "raster",
                        source: "traffic",
                        paint: { "raster-opacity": trafficOpacity },
                    },
                    ...labelLayers(true),
                ],
            };

            function fillLayers() {
                return [
                    {
                        id: "background",
                        type: "background",
                        paint: { "background-color": c.background },
                    },
                    {
                        id: "land",
                        type: "fill",
                        source: "turin",
                        "source-layer": "land",
                        paint: {
                            "fill-color": [
                                "match",
                                ["get", "kind"],
                                "forest",
                                c.land.forest,
                                "wood",
                                c.land.wood,
                                "grass",
                                c.land.grass,
                                "park",
                                c.land.park,
                                "garden",
                                c.land.garden,
                                "meadow",
                                c.land.meadow,
                                "scrub",
                                c.land.scrub,
                                "heath",
                                c.land.heath,
                                "wetland",
                                c.land.wetland,
                                "farming",
                                c.land.farming,
                                "residential",
                                c.land.residential,
                                "industrial",
                                c.land.industrial,
                                "sand",
                                c.land.sand,
                                "glacier",
                                c.land.glacier,
                                c.land.residential,
                            ],
                        },
                    },
                    {
                        // land and natural_detail carry overlapping features; keep
                        // this one restricted to what land does not already draw.
                        id: "natural_detail",
                        type: "fill",
                        source: "turin",
                        "source-layer": "natural_detail",
                        paint: {
                            "fill-color": [
                                "match",
                                ["get", "kind"],
                                "shrubbery",
                                c.land.scrub,
                                "meadow",
                                c.land.meadow,
                                "grassland",
                                c.land.grass,
                                "heath",
                                c.land.heath,
                                "wetland",
                                c.land.wetland,
                                c.natural,
                            ],
                            "fill-opacity": 0.6,
                        },
                    },

                    {
                        id: "barriers",
                        type: "line",
                        source: "protomaps",
                        "source-layer": "barriers",
                        minzoom: 13,
                        filter: ["==", ["geometry-type"], "LineString"],
                        paint: {
                            "line-color": "#9b9187",
                            "line-width": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                14,
                                0.5,
                                20,
                                2,
                            ],
                        },
                    },
                    {
                        id: "water",
                        type: "fill",
                        source: "turin",
                        "source-layer": "water_polygons",
                        paint: { "fill-color": c.water },
                    },
                    {
                        id: "buildings",
                        type: "fill",
                        source: "turin",
                        "source-layer": "buildings",
                        paint: { "fill-color": c.buildings },
                    },
                ];
            }

            function lineLayers() {
                return [
                    {
                        id: "waterway",
                        type: "line",
                        source: "turin",
                        "source-layer": "water_lines",
                        paint: {
                            "line-color": c.water,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                10,
                                0.5,
                                16,
                                4,
                            ],
                        },
                    },
                    {
                        id: "road_minor",
                        type: "line",
                        source: "turin",
                        "source-layer": "streets",
                        filter: ["==", ["get", "kind"], "residential"],
                        paint: {
                            "line-color": c.minor,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                12,
                                0.5,
                                16,
                                3,
                                18,
                                8,
                            ],
                        },
                    },
                    {
                        id: "road_major",
                        type: "line",
                        source: "turin",
                        "source-layer": "streets",
                        filter: [
                            "in",
                            ["get", "kind"],
                            ["literal", ["primary", "secondary", "tertiary"]],
                        ],
                        paint: {
                            "line-color": c.major,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                8,
                                0.5,
                                14,
                                4,
                                18,
                                14,
                            ],
                        },
                    },
                    {
                        id: "road_highway",
                        type: "line",
                        source: "turin",
                        "source-layer": "streets",
                        filter: [
                            "in",
                            ["get", "kind"],
                            ["literal", ["motorway", "trunk"]],
                        ],
                        paint: {
                            "line-color": c.highway,
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                6,
                                1,
                                12,
                                3,
                                18,
                                16,
                            ],
                        },
                    },
                    {
                        id: "railway",
                        type: "line",
                        source: "turin",
                        "source-layer": "streets",
                        filter: ["==", ["get", "kind"], "rail"],
                        paint: {
                            "line-color": c.railway,
                            "line-dasharray": [0.3, 0.75],
                            "line-width": [
                                "interpolate",
                                ["exponential", 1.6],
                                ["zoom"],
                                10,
                                0.5,
                                18,
                                6,
                            ],
                        },
                    },
                    {
                        id: "boundaries",
                        type: "line",
                        source: "turin",
                        "source-layer": "boundaries",
                        paint: {
                            "line-color": c.boundary,
                            "line-width": 0.6,
                            "line-dasharray": [2, 1],
                        },
                    },
                    {
                        id: "barriers",
                        type: "line",
                        source: "turin",
                        "source-layer": "barriers",
                        paint: {
                            "line-color": [
                                "match",
                                ["get", "kind"],
                                "hedge",
                                c.hedge,
                                "retaining_wall",
                                c.barrier,
                                c.barrier,
                            ],
                            "line-opacity": 0.7,
                            "line-width": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                15,
                                0.5,
                                18,
                                2,
                            ],
                        },
                    },
                ];
            }

            // Labels are emitted twice: once under the traffic raster and once
            // over it, with `lifted` only changing the id prefix. Simple, and it
            // keeps street names legible through a 60% raster overlay.
            function labelLayers(lifted = false) {
                const prefix = lifted ? "top_" : "";
                return [
                    {
                        id: `${prefix}place_label`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "place_labels",
                        minzoom: 6,
                        layout: {
                            "text-field": [
                                "coalesce",
                                ["get", "name"],
                                ["get", "ref"],
                                "",
                            ],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": [
                                "interpolate",
                                ["linear"],
                                ["zoom"],
                                8,
                                11,
                                14,
                                16,
                            ],
                        },
                        paint: {
                            "text-color": c.label,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1.2,
                        },
                    },
                    {
                        id: `${prefix}street_label`,
                        type: "symbol",
                        source: "turin",
                        "source-layer": "street_labels",
                        minzoom: 14,
                        layout: {
                            "symbol-placement": "line",
                            "text-field": [
                                "coalesce",
                                ["get", "name"],
                                ["get", "ref"],
                            ],
                            "text-font": ["Noto Sans Regular"],
                            "text-size": 11,
                        },
                        paint: {
                            "text-color": c.labelRoad,
                            "text-halo-color": c.halo,
                            "text-halo-width": 1,
                        },
                    },
                    {
                        id: `${prefix}pois`,
                        type: "circle",
                        source: "turin",
                        "source-layer": "pois",
                        minzoom: 16,
                        paint: {
                            "circle-radius": 3,
                            "circle-color": c.labelSoft,
                            "circle-stroke-width": 1,
                            "circle-stroke-color": c.halo,
                        },
                    },
                ];
            }

            const map = new maplibregl.Map({
                container: "map",
                style: basemapStyle,
                center,
                zoom,
                minZoom,
                maxZoom,
                attributionControl: {
                    compact: true,
                    customAttribution: "turinflow.com.br",
                },
            });
        </script>
    </body>
</html>
