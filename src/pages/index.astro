---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import '../assets/styles/fonts.css';
import '../assets/styles/body.css';

---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TurinFlow: Saia no horário certo.</title>
    <style>

        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            --brand-main: #FFD700;
            --brand-dark: #333;
            --bg-light: #f9f9f9;
            --light-2: #eee;
            --mid-color1: #bec1b9;
            --mid-color: #131b21;
            --darker-1: #474646;
        }

        .row {flex-direction: column; row-gap: 0.6rem;}       
        
        @media (min-width: 768px) {
            .row {flex-direction: row;}
        }
    </style>
</head>

<script
    src="https://sp.turinflow.com.br/api/script.js"
    data-site-id="3a248a45ee62"
    defer
></script>

<body>
    <Header />
        <div style="margin-top: 8rem; margin-bottom: 8rem;">
            <div class="s1" style="font-size: 69px; line-height: 69px; color: #111; justify-self: center; margin-bottom: 8px;">NUNCA MAIS SAIA ATRASADO.</div>
            <div class="g2" style="font-size: 21px; line-height: 21px; color: #000; justify-self: center;">Turin ajuda você para sempre sair adiantado. Ajudamos você a coordenar sua viagem mais importante do dia.</div>
        </div>

        <div style="margin-top: 4rem; background-color: #fff; height: 100rem;">
            <div class="s1" style="font-size: 120px; line-height: 120px; color: #eee; justify-self: center; margin-bottom: 8px;">TURINFLOW</div>
            <div class="g2" style="font-size: 21px; line-height: 21px; color: #111; justify-self: center;">Ficamos de olho de todas suas rotas, e acionamos você somente quando necessário.</div>
        </div>
</body>
</html>

