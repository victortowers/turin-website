---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import '../assets/styles/fonts.css';
import '../assets/styles/body.css';

---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turin: Saia no horário certo.</title>

    <meta name="description" content="Trânsito em tempo real para você sempre sair no horário certo.">
    <link rel="canonical" href="https://turinflow.com.br/">
    <style>

        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            --brand-main: #FFD700;
            --brand-dark: #333;
            --bg-light: #f9f9f9;
            --light-2: #eee;
            --mid-color1: #bec1b9;
            --mid-color: #131b21;
            --darker-1: #474646;
        }

        .row {flex-direction: column; row-gap: 0.6rem;}       
        
        @media (min-width: 768px) {
            .row {flex-direction: row;}
        }
    </style>
</head>

<script
    src="https://sp.turinflow.com.br/api/script.js"
    data-site-id="3a248a45ee62"
    defer
></script>

<body>
    <Header />
        <div style="margin-top: 8rem; margin-bottom: 8rem;">
            <div class="s1" style="font-size: 69px; line-height: 69px; color: #111; justify-self: center; margin-bottom: 8px;">NUNCA MAIS SAIA ATRASADO.</div>
            <div class="g2" style="font-size: 21px; line-height: 21px; color: #000; justify-self: center;">Turin ajuda você para sempre sair adiantado. Ajudamos você a coordenar sua viagem mais importante do dia.</div>
        </div>

        <div style="background-color: #fff;">

            <div class="s1" style="padding-top: 4rem; font-size: 60px; line-height: 60px; color: #eee; justify-self: center; margin-bottom: 8px;">NASCEMOS EM BREVE.</div>
            <div class="g2" style="padding-bottom: 8rem; font-size: 21px; line-height: 21px; color: #111; justify-self: center;">Em breve, disponível na App Store e no Google Play.</div>            
        </div>

        <div class="s1" style="padding-top: 4rem; font-size: calc(100vw * 0.159); line-height: calc(100vw * 0.159); color: #aaa; justify-self: center; margin-bottom: 8px;">TURINFLOW</div>
        <div class="g2" style="padding-bottom: 4rem; font-size: 21px; line-height: 21px; color: #111; justify-self: center;">Simplesmente surpreendente.</div>

</body>
</html>

