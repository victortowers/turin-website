---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Bottom from '../components/bottom-logo.astro';

import '../assets/styles/fonts.css';
import '../assets/styles/body.css';

---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turin: Saia no horário certo.</title>

    <meta name="description" content="Trânsito em tempo real para você sempre sair no horário certo.">
    <link rel="canonical" href="https://turinflow.com.br/">
    <style>

        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            --brand-main: #FFD700;
            --brand-dark: #333;
            --bg-light: #f9f9f9;
            --light-2: #eee;
            --mid-color1: #bec1b9;
            --mid-color: #131b21;
            --darker-1: #474646;
        }

        .row {flex-direction: column; row-gap: 0.6rem;}
        .row-reverse {flex-direction: row; row-gap: 0.6rem; }    

        .images {
            height: 50vw; 
            margin: 16px;
        }

        .font-default {
            height: calc(100vw * 0.091); 
            font-size: clamp(25px, calc(100vw * 0.076), 165px); 
            line-height: clamp(25px, calc(100vw * 0.076), 170px);
        }

        .images-flex {
            width: 95vw; 
            display: flex; 
            margin-inline: auto; 
            justify-content: space-between; 
            height: 1100px;
            gap: 1.3rem; 
        }

        .widgets-1 {
            display: flex; 
            flex-direction: column; 
            flex: 0 0 30%;
            border: 1px solid #add1d1;
            padding: 0.5rem; 
        }

        @media (min-width: 768px) {
            .row-reverse {flex-direction: column;}

            .images {
                height: 50%; margin: 16px;
            }

            .font-default {
                height: calc(100vw * 0.091); 
                font-size: clamp(25px, calc(100vw * 0.076), 165px); 
                line-height: clamp(25px, calc(100vw * 0.076), 170px);
            }

            .images-flex {
                width: 85vw; 
                height: 550px;
                gap: 0.5rem;
            }

            .widgets-1 {
                flex: 0 0 32%;
            }
        }

        @media (min-width: 900px) {
            .row {flex-direction: row;}
        }
    </style>
</head>

<script
    src="https://sp.turinflow.com.br/api/script.js"
    data-site-id="3a248a45ee62"
    defer
></script>

<body>
    <Header />
        <div style="margin-top: 2rem; margin-bottom: 8rem;">
            <div class="s1" style="width: 85vw; font-size: clamp(40px, calc(100vw * 0.131), 165px); line-height: clamp(40px, calc(100vw * 0.131), 170px); color: #444444; margin-inline: auto; margin-bottom: 8px;">NUNCA MAIS SAIA ATRASADO.</div>
            <div class="g2" style="width: 85vw; font-size: 21px; line-height: 21px; color: #000; margin-inline: auto;">Turin ajuda você para sempre sair adiantado. Ajudamos você a coordenar sua viagem mais importante do dia.</div>
        </div>

        <div style="background-color: #add1d1; padding-top: 2rem; padding-bottom: 8rem;">
            <div class="s1" style="width: 85vw; font-size: clamp(40px, calc(100vw * 0.131), 165px); line-height: clamp(40px, calc(100vw * 0.131), 170px); color: #333333; margin-inline: auto; margin-bottom: 8px;">INCIDENTES, EM TEMPO REAL.</div>
            <div class="g2" style="width: 85vw; font-size: 21px; line-height: 21px; color: #000; margin-inline: auto;">Acidentes, Trânsito e Obras Inesperadas nunca mais! Avisaremos se necessário, dando a você controle sobre suas viagems todos os dias.</div>

        </div>

        <div style="background-color: #bc9bf4; padding-top: 2rem; padding-bottom: 8rem; min-height: 710px;">
            <div class="row images-flex">
                <div class="widgets-1">
                    <span class="s1" style="margin: 9px; font-size: 21px; line-height: 21px; color: #000; text-align: center;">Família em primeiro lugar.</span>
                    <div class="images" style="background-color: #ddd;"></div>
                    <span class="g2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Protegemos sua família. Cheque quem chegou em casa, e saiba instantaneamente se alguém saiu.</span>
                </div>

                <div class="widgets-1">
                    <span class="s1" style="margin: 9px; font-size: 21px; line-height: 21px; color: #000; text-align: center;">Chegando no horário certo.</span>
                    <div class="images" style="background-color: #555;"></div>
                    <span class="g2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Saia no horário certo para chegar no horário certo. Para você, ou para a família inteira.</span>
                </div>

                <div class="widgets-1">
                    <span class="s1" style="margin: 9px; font-size: 21px; line-height: 21px; color: #000; text-align: center;">Coordenando sua vida inteira.</span>
                    <div class="images" style="background-color: #000;"></div>
                    <span class="g2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Com o Canarinho, coordene cada viagem do seu dia. A academia, a escola de seu filho, o seu trabalho. Cuide dos detalhes. Cuidaremos do seu trajeto.</span>
                </div>
            </div>
        </div>


        <div style="background-color: #dec1fd; padding-top: 2rem; padding-bottom: 8rem; min-height: 710px; height: auto;">
            
            <div class="row" style="width: 85vw; gap: 10px; display: flex; margin-inline: auto; justify-content: space-between; row-gap: calc(100vw * 0.02); height: auto; flex-wrap: wrap;">
        
                <span class="s1" style="width: 85vw; margin-top: calc(100vw * 0.03500); margin-bottom: calc(100vw * 0.01500); height: calc(100vw * 0.1); font-size: calc(100vw * 0.073); line-height: calc(100vw * 0.073); color: #111; justify-self: bottom; border-bottom: 1px solid #fff; text-align: center; align-items: flex-start;">NOSSOS RECURSOS</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Alertas de Trânsito e Acidentes</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Previsão de Chegada</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Integração Google Maps e Waze</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Coordenação de Chegada (chegue nos mesmos horários)</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Assitente Canarinho (saiba do necessário)</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Saída Inteligente</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Rotas mais Frequentes</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Notificações Personalizados</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Adaptação à sua rotina</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Eficiente no 4G e 5G</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Avisos de chegada (para Familiares)</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Avisos de Saídas (para Familiares)</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Adaptado para o trânsito de SP</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Seus dados no seu dispositivo</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Rotas sem internet</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Compartilhe com até 5 pessoas</span>
                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Alertas de Inprevistos</span>

                <span class="n2" style="margin: 9px; font-size: 17px; line-height: 23px; color: #000; text-align: center;">Notificações Interativas (somente para iOS)</span>
            </div>
        </div>

        <div style="background-color: #fff;">

            <div class="s1" style="width: 85vw; padding-top: 4rem; font-size: clamp(40px, calc(100vw * 0.131), 165px); line-height: clamp(40px, calc(100vw * 0.131), 165px); color: #ccc; margin-inline: auto; margin-bottom: 8px;">FAÇA PARTE DO NOSSO FUTURO.</div>
            <div class="g2" style="width: 85vw; padding-bottom: 8rem; font-size: 21px; line-height: 21px; color: #111; margin-inline: auto;">Em breve, disponível na App Store (para iOS) e na Play Store (para Android).</div>            
        </div>

        
        <Bottom />
</body>
</html>

