---
import { ClientRouter } from "astro:transitions";

import "../assets/styles/fonts.css";
import "../assets/styles/body.css";
---

<!doctype html>
<html lang="en">
    <head>
        <ClientRouter />
        <meta charset="UTF-8" />
        <link rel="canonical" href="https://turinflow.com.br/login" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta
            name="description"
            content="Faça login nesta página. Acesse tudo que o Turin pode fazer por você."
        />

        <title>Sign in</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                font-family: s1, system-ui, sans-serif;
                padding: 20px;
                margin-inline: auto;
                width: min(1100px, 99%);
            }

            button:disabled {
                cursor: not-allowed;
                opacity: 0.6;
            }

            button,
            .board1,
            .button1 {
                width: 93%;
                text-decoration: none;
                color: #666;
                border: 1px solid rgba(110, 110, 110, 0.1);

                transition: 0.55s ease-in-out;
                border-radius: 8px;
                padding: 12px;
                cursor: pointer;
                margin-top: 10px;
                transition: 0.41s ease-in-out;
            }

            .button2 {
                background-color: inherit;
                border: 1px solid rgba(220, 220, 220, 0.1);
                transition: 0.41s ease-in-out;
            }

            .button2:hover {
                background-color: rgba(111, 136, 136, 0.1);
                transition: 0.41s ease-in-out;
            }

            button:hover,
            .board1:hover {
                background-color: rgba(111, 136, 136, 0.15);
                transition: 0.41s ease-in-out;
            }

            #user-info {
                margin-top: 20px;
                padding: 15px;
                background: #eee;
            }

            #error {
                color: #b00020;
                margin-top: 15px;
            }

            .hidden {
                display: none;
            }

            /*
             * Authentication processing overlay
             */

            #auth-processing {
                position: fixed;
                inset: 0;

                display: none;
                align-items: center;
                justify-content: center;
                backdrop-filter: blur(4px) saturate(110%);
                -webkit-backdrop-filter: blur(4px) saturate(110%);
                background: rgba(200, 200, 200, 0.75);

                z-index: 9999;
            }

            #auth-processing.active {
                display: flex;
            }

            .auth-processing-content {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;

                text-align: center;
            }

            .auth-spinner {
                width: 32px;
                height: 32px;

                border: 3px solid #ddd;
                border-top-color: #333;
                border-radius: 50%;

                /* Total duration scaled to 3.3s (1.1s * 3 steps) */
                animation: auth-spin 2.6s cubic-bezier(0.4, 0, 0.5, 1) infinite;
            }

            #auth-processing-message {
                color: #555;
                font-size: 0.95rem;
            }

            @keyframes auth-spin {
                0% {
                    transform: rotate(0deg);
                }
                50% {
                    transform: rotate(540deg);
                }
                100% {
                    transform: rotate(1080deg);
                }
            }
        </style>
    </head>

    <body>
        <!--
            LOGGED OUT
        -->
        <div
            id="login"
            style="margin-inline: auto; text-align: center; border: 1px solid #999; border-radius: 8px; padding: 1rem; max-width: 800px;"
        >
            <pre id="auth-debug"></pre>

            <img
                src="https://www.turinflow.com.br/assets/login-image.png"
                style="width: 100%; border-radius: 8px; border: 1px solid #999"
                alt="Image of Parque Ibirapuera, Large Park in São Paulo."
            />

            <div
                class="s1"
                style="font-size: min(3vw, 14px); font-weight: 300; color: #777; padding: 0rem; margin: 0;"
            >
                Parque Ibirapuera. Maps &copy; Mapbox; Data © Openstreetmap.
            </div>
            <h1
                class="s1"
                style="font-size: 25px; font-weight: 300; color: #999; padding: 1rem; padding-bottom: 0rem; margin-bottom: 0.25rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed #888"
            >
                Utilize sua conta Turin para continuar.
            </h1>

            <button
                class="n3"
                id="google-login"
                style="margin-inline: auto; display: flex; justify-content: center;"
            >
                <img
                    src="https://www.turinflow.com.br/assets/Google_Favicon_2025.svg"
                    style="align-items: center; height: 20px; padding-right: 12px; padding-left: 16px;"
                />
                <span style="font-color: #1f1f1f; display: flex; align-items: center; justify-content: center; line-height: 14px; font-size: 14px;">
                    Continue com Google
                </span>
            </button>

            <button
                id="oidc-login"
                class="n3"
                style="margin-inline: auto; display: flex; justify-content: center; font-color: #1f1f1f; display: flex; align-items: center; justify-content: center; line-height: 20px; font-size: 14px;"
            >
                Continue com Pocket ID (SSO)
            </button>
            <button
                class="button1 button2 s1"
                id="back-button"
                onclick="location.href = '/'"
            >
                &lt; Volte para a página anterior
            </button>
            <div id="error"></div>
        </div>

        <!--
            LOGGED IN
        -->

        <div id="logged-in" class="hidden">
            <div id="header-title"></div>
            <div
                id="user-info"
                style="background-color: rgba(110, 110, 110, 0.1);"
                class="board1"
            ></div>

            <button id="logout">Sign out</button>
        </div>

        <!--
            AUTHENTICATION PROCESSING OVERLAY
        -->

        <div id="auth-processing" aria-live="polite" aria-busy="true">
            <div class="auth-processing-content">
                <div class="auth-spinner"></div>

                <div id="auth-processing-message">Authenticando…</div>
            </div>
        </div>

        <!--
            Firebase Authentication SDK

            Identity Platform uses this SDK on the client side.
        -->
        <script type="module" data-astro-rerun>
            import {
                initializeApp,
                getApps,
                getApp,
            } from "https://www.gstatic.com/firebasejs/12.2.1/firebase-app.js";

            import {
                getAuth,
                GoogleAuthProvider,
                OAuthProvider,
                signInWithRedirect,
                getRedirectResult,
                onAuthStateChanged,
                signOut,
            } from "https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";

            /*
             * Astro can rerun this script after client-side navigation.
             * Keep Firebase and its permanent listeners in one window-level
             * singleton, and use delegated clicks so replaced buttons still work.
             */
            const STATE_KEY = "__turinflowAuthState";
            const state =
                window[STATE_KEY] ??
                (window[STATE_KEY] = {
                    auth: null,
                    googleProvider: null,
                    pocketIdProvider: null,
                    currentUser: null,
                    profile: null,
                    processedUid: null,
                    clickHandlerInstalled: false,
                    pageLoadHandlerInstalled: false,
                    pageShowHandlerInstalled: false,
                    authObserverInstalled: false,
                    redirectCheckStarted: false,
                });

            const firebaseConfig = {
                apiKey: "AIzaSyASIFTLz8371OOiQxz0b0lKuq9Oa4Cwv8Y",
                authDomain: "turinflow.com.br",
            };

            // Initialize Firebase only once, even if Astro reruns this script.
            if (!state.auth) {
                const app = getApps().length
                    ? getApp()
                    : initializeApp(firebaseConfig);
                state.auth = getAuth(app);
                state.googleProvider = new GoogleAuthProvider();
                state.pocketIdProvider = new OAuthProvider("oidc.pocket-id");
            }

            const auth = state.auth;
            const googleProvider = state.googleProvider;
            const pocketIdProvider = state.pocketIdProvider;
            const API_ME_URL = "https://f.turinflow.com.br/me";
            const SESSION_LOGIN_URL = "https://f.turinflow.com.br/sessionLogin";

            function element(selector) {
                return document.querySelector(selector);
            }

            function showProcessing(message) {
                const overlay = element("#auth-processing");
                const messageElement = element("#auth-processing-message");
                if (messageElement) messageElement.textContent = message;
                if (overlay) overlay.classList.add("active");
                const googleButton = element("#google-login");
                const pocketIdButton = element("#oidc-login");
                if (googleButton) googleButton.disabled = true;
                if (pocketIdButton) pocketIdButton.disabled = true;
            }

            function hideProcessing() {
                const overlay = element("#auth-processing");
                if (overlay) overlay.classList.remove("active");
                const googleButton = element("#google-login");
                const pocketIdButton = element("#oidc-login");
                if (googleButton) googleButton.disabled = false;
                if (pocketIdButton) pocketIdButton.disabled = false;
            }

            function showError(message) {
                const errorElement = element("#error");
                if (errorElement) errorElement.textContent = message;
            }

            function clearError() {
                const errorElement = element("#error");
                if (errorElement) errorElement.textContent = "";
            }

            function escapeHtml(value) {
                return String(value ?? "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function getGreeting() {
                const hour = new Date().getHours();
                if (hour >= 5 && hour < 12) return "Bom Dia";
                if (hour >= 12 && hour < 17) return "Boa Tarde";
                return "Boa Noite";
            }

            function renderProfile(profile) {
                const userInfo = element("#user-info");
                const headerTitle = element("#header-title");
                if (!userInfo || !headerTitle || !profile) return;

                const displayName =
                    String(profile.name ?? "Usuário")
                        .trim()
                        .split(/\s+/)[0] || "Usuário";
                headerTitle.innerHTML = `
                    <h1 style="font-size: 21px; margin-bottom: 0;">
                        ${escapeHtml(`${getGreeting()}, ${displayName}.`)}
                    </h1>
                    <i>O que podemos fazer pelo seu dia, hoje?</i>
                `;

                const expiryTimestamp = Number(profile.expiry);
                const expiryDate =
                    Number.isFinite(expiryTimestamp) && expiryTimestamp > 0
                        ? new Date(expiryTimestamp * 1000)
                        : null;
                const readableExpiry =
                    expiryDate && !Number.isNaN(expiryDate.getTime())
                        ? expiryDate.toLocaleString()
                        : "Desconhecido";

                userInfo.innerHTML = `
                    ${profile.picture ? `<img src="${escapeHtml(profile.picture)}" alt="Foto do perfil" width="64" height="64" style="border-radius: 50%; object-fit: cover;"><br>` : ""}
                    <strong>Nome:</strong> ${escapeHtml(profile.name || "Usuário")}<br>
                    <strong>Email:</strong> ${escapeHtml(profile.email || "Não informado")}<br>
                    <strong>Email verificado:</strong> ${profile.email_verified === true ? "Sim" : "Não"}<br>
                    <strong>User ID:</strong> ${escapeHtml(profile.uid || "Desconhecido")}<br>
                    <strong>Método de login:</strong> ${escapeHtml(profile.login_method || "Desconhecido")}<br>
                    <strong>Expiração da sessão:</strong> ${escapeHtml(readableExpiry)}
                `;
            }

            function renderAuthUI(user = state.currentUser) {
                const login = element("#login");
                const loggedIn = element("#logged-in");
                if (!login || !loggedIn) return;

                if (!user) {
                    login.classList.remove("hidden");
                    loggedIn.classList.add("hidden");
                    return;
                }

                login.classList.add("hidden");
                loggedIn.classList.remove("hidden");
                if (state.profile) renderProfile(state.profile);
            }

            async function startLogin(provider, providerName) {
                clearError();
                try {
                    showProcessing("Carregando, aguarde...");
                    fetch("https://f.turinflow.com.br/me", {
                        method: "GET",
                        credentials: "include",
                        headers: { Accept: "application/json" },
                    });
                    sessionStorage.setItem("authRedirectPending", providerName);
                    await signInWithRedirect(auth, provider);
                } catch (error) {
                    sessionStorage.removeItem("authRedirectPending");
                    hideProcessing();
                    console.error(
                        `${providerName} authentication error:`,
                        error,
                    );
                    showError(
                        error?.message ||
                            "Não foi possível fazer login. Tente mais tarde.",
                    );
                }
            }

            async function handleLogout() {
                clearError();
                showProcessing("Fazendo logout...");
                try {
                    const response = await fetch(
                        "https://auth.turinflow.com.br/sessionLogout",
                        {
                            method: "POST",
                            credentials: "include",
                        },
                    );
                    if (!response.ok) {
                        throw new Error(
                            `Logout failed: HTTP ${response.status}`,
                        );
                    }
                    state.profile = null;
                    state.processedUid = null;
                    await signOut(auth);
                    renderAuthUI(null);
                } catch (error) {
                    console.error("Sign out error:", error);
                    showError(
                        error?.message || "Não foi possível fazer logout.",
                    );
                } finally {
                    hideProcessing();
                }
            }

            // One delegated listener survives Astro replacing the page's HTML.
            if (!state.clickHandlerInstalled) {
                document.addEventListener("click", async (event) => {
                    if (!(event.target instanceof Element)) return;
                    if (event.target.closest("#google-login")) {
                        event.preventDefault();
                        await startLogin(googleProvider, "google");
                    } else if (event.target.closest("#oidc-login")) {
                        event.preventDefault();
                        await startLogin(pocketIdProvider, "pocket-id");
                    } else if (event.target.closest("#logout")) {
                        event.preventDefault();
                        await handleLogout();
                    }
                });
                state.clickHandlerInstalled = true;
            }

            // Render against the newly navigated page, not stale element references.
            if (!state.pageLoadHandlerInstalled) {
                document.addEventListener("astro:page-load", () => {
                    renderAuthUI(state.currentUser);
                    const redirectProvider = sessionStorage.getItem(
                        "authRedirectPending",
                    );
                    if (redirectProvider) {
                        showProcessing(
                            redirectProvider === "google"
                                ? "Finalizando, aguarde…"
                                : "Completing Pocket ID authentication…",
                        );
                    }
                });
                state.pageLoadHandlerInstalled = true;
            }

            if (!state.pageShowHandlerInstalled) {
                window.addEventListener("pageshow", (event) => {
                    if (
                        event.persisted ||
                        performance.getEntriesByType("navigation")[0]?.type ===
                            "back_forward"
                    ) {
                        sessionStorage.removeItem("authRedirectPending");
                        hideProcessing();
                    }
                });
                state.pageShowHandlerInstalled = true;
            }

            // Check the OAuth redirect result only once for this browser document.
            if (!state.redirectCheckStarted) {
                state.redirectCheckStarted = true;
                const redirectProvider = sessionStorage.getItem(
                    "authRedirectPending",
                );
                if (redirectProvider) {
                    showProcessing(
                        redirectProvider === "google"
                            ? "Finalizando, aguarde…"
                            : "Completing Pocket ID authentication…",
                    );
                }

                console.log("Checking Firebase redirect result...");
                try {
                    const result = await getRedirectResult(auth);
                    sessionStorage.removeItem("authRedirectPending");
                    console.log(
                        result
                            ? "Redirect authentication succeeded"
                            : "No pending redirect",
                        result || "",
                    );
                    hideProcessing();
                } catch (error) {
                    sessionStorage.removeItem("authRedirectPending");
                    hideProcessing();
                    console.error("REDIRECT ERROR:", error);
                    console.error("Code:", error?.code);
                    console.error("Message:", error?.message);
                    showError(
                        `${error?.code || "unknown"}: ${error?.message || "Erro no redirecionamento."}`,
                    );
                }
            }

            // Subscribe to Firebase auth state only once. Query the DOM inside handlers.
            if (!state.authObserverInstalled) {
                state.authObserverInstalled = true;
                onAuthStateChanged(auth, async (user) => {
                    state.currentUser = user;
                    if (!user) {
                        state.profile = null;
                        state.processedUid = null;
                        renderAuthUI(null);
                        return;
                    }

                    renderAuthUI(user);
                    if (state.processedUid === user.uid) {
                        if (state.profile) renderProfile(state.profile);
                        return;
                    }
                    state.processedUid = user.uid;
                    showProcessing("Verificando sua sessão...");

                    try {
                        const idToken = await user.getIdToken();
                        const sessionResponse = await fetch(SESSION_LOGIN_URL, {
                            method: "POST",
                            credentials: "include",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ idToken }),
                        });
                        if (!sessionResponse.ok) {
                            throw new Error(
                                `Session creation failed: HTTP ${sessionResponse.status}`,
                            );
                        }

                        const response = await fetch(API_ME_URL, {
                            method: "GET",
                            credentials: "include",
                            headers: { Accept: "application/json" },
                        });
                        if (response.status === 401) {
                            throw new Error(
                                "Sua sessão é inválida ou expirou. Faça login novamente.",
                            );
                        }
                        if (!response.ok) {
                            throw new Error(
                                `Profile request failed: HTTP ${response.status}`,
                            );
                        }

                        state.profile = await response.json();
                        renderAuthUI(user);
                        renderProfile(state.profile);
                    } catch (error) {
                        console.error("Authentication/profile error:", error);
                        showError(
                            error?.message ||
                                "Não foi possível carregar o perfil.",
                        );
                        const userInfo = element("#user-info");
                        const headerTitle = element("#header-title");
                        if (userInfo)
                            userInfo.textContent =
                                error?.message ||
                                "Não foi possível carregar seu perfil.";
                        if (headerTitle)
                            headerTitle.textContent =
                                "Não foi possível verificar sua sessão.";
                        state.profile = null;
                        state.processedUid = null;
                        await signOut(auth).catch((signOutError) => {
                            console.error(
                                "Firebase sign-out error:",
                                signOutError,
                            );
                        });
                        renderAuthUI(null);
                    } finally {
                        hideProcessing();
                    }
                });
            }

            // Also update immediately on initial page load (before Astro's event fires).
            renderAuthUI(state.currentUser);
        </script>
    </body>
</html>
