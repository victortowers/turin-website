---
import Header from "../components/Header.astro";
import Bottom from "../components/bottom-logo.astro";
import Constuction from "../components/construction.astro";

import "../assets/styles/fonts.css";
import "../assets/styles/body.css";
---

<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Turin: Saia no horário certo.</title>

        <meta
            name="description"
            content="Trânsito em tempo real para você sempre sair no horário certo."
        />
        <link rel="canonical" href="https://turinflow.com.br/" />
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            :root {
                --brand-main: #ffd700;
                --brand-dark: #333;
                --bg-light: #f9f9f9;
                --light-2: #eee;
                --mid-color1: #bec1b9;
                --mid-color: #131b21;
                --darker-1: #474646;
            }
        </style>
    </head>

    <script
        src="https://sp.turinflow.com.br/api/script.js"
        data-site-id="3a248a45ee62"
        defer
    ></script>
    <body>
        <Header />
        <div style="background-color: rgba(250, 250, 250, 1);">
            <div
                class="s1"
                style="width: 85vw; padding-top: 4rem; font-size: clamp(40px, calc(100vw * 0.069), 165px); line-height: clamp(40px, calc(100vw * 0.069), 165px); color: #888; margin-inline: auto; margin-bottom: 16px;"
            >
                PÁGINA DE STATUS
            </div>
            <div
                class="s1"
                style="width: 85vw; padding-bottom: 8rem; font-size: 21px; line-height: 28px; color: #111; margin-inline: auto;"
            >
                Cheque esta página para verificar a disponibilidade do sistema
                Turin e dos nossos aplicativos. <br />
                Em breve, esta página estará pronto para uso.
            </div>
            .
        </div>
    </body>

    <Constuction />
    <Bottom />
</html>
