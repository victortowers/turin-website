---
import Header from "../components/Header.astro";
import Footer from "../components/bottom-logo.astro";

import "../assets/styles/fonts.css";
import "../assets/styles/body.css";
import "../assets/styles/globals.css";
---

<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="canonical"
            href="https://turinflow.com.br/transito-ao-vivo"
        />

        <meta
            name="description"
            content="Turin, o site do trânsito em tempo real. Veja rotas pré-determinadas para entender o que está acontecendo."
        />
        <title>Visão Geral Alphaville | Trânsito ao Vivo</title>
        <style>
            :root {
                --brand-main: #ffd700;
                --brand-dark: #333;
                --bg-light: #f9f9f9;
            }
        </style>
    </head>

    <script
        src="https://sp.turinflow.com.br/api/script.js"
        data-site-id="3a248a45ee62"
        defer
    ></script>
    <body>
        <Header />
        <!-- THE LOADING THEATER -->
        <div id="loader" style="min-height: 80vw;">
            <div class="canary-icon">🐦</div>
            <p id="loader-text">O Canário está juntando os dados. Aguarde...</p>
            <div class="scale-container">
                <div id="progress-bar" class="scale-progress"></div>
                <div class="shimmer"></div>
            </div>
        </div>

        <!-- THE PRODUCTION DASHBOARD -->

        <div
            id="dashboard"
            style="height: auto; min-width: 85vw; margin-inline: auto; flex-direction: column; background-color: rgba(23, 36, 18, 0.09); padding-bottom: 3rem;"
        >
            <h1
                style="color: #777; text-align: center; margin-top: 1rem; margin-bottom: 2rem;  "
                class="monospace"
            >
                Visão Geral - Trânsito de Alphaville
            </h1>
            <div
                id="names2"
                style="display: flex; flex-direction: column;"
            ></div>
        </div>

        <Footer />
        <script>
            let API_BASE = "https://api.turinflow.com.br";

            /**
             * World-Class PoW Solver
             * Uses SubtleCrypto for hardware-level speed
             */
            async function solveChallenge(salt, difficulty) {
                const prefix = "0".repeat(difficulty);
                let nonce = 0;
                const progressBar = document.getElementById("progress-bar");

                while (true) {
                    const data = salt + nonce;
                    const msgBuffer = new TextEncoder().encode(data);
                    const hashBuffer = await crypto.subtle.digest(
                        "SHA-256",
                        msgBuffer,
                    );
                    const hashArray = Array.from(new Uint8Array(hashBuffer));
                    const hashHex = hashArray
                        .map((b) => b.toString(16).padStart(2, "0"))
                        .join("");

                    if (hashHex.startsWith(prefix)) return nonce;
                    nonce++;

                    // Update "Feather Weight" animation every 500 attempts
                    if (nonce % 500 === 0) {
                        // Simulating weight accumulation up to 90%
                        if (progressBar) {
                            const p = Math.min(90, (nonce / 5000) * 100);
                            const safeP = Number.isFinite(p) ? p : 0;
                            progressBar.style.width = `${safeP || 0}%`;
                        }

                        // Brief pause to keep UI thread alive
                        await new Promise((r) => setTimeout(r, 0));
                    }
                }
            }

            /**
             * The Unified Data Workflow
             */
            async function runCanaryEngine(
                options = {},
                first_loading = false,
            ) {
                const { timeout = 11000 } = options;
                const controller = new AbortController();
                const timer = setTimeout(() => controller.abort(), timeout);

                try {
                    // 1. Get Challenge
                    const challengeRes = await fetch(
                        `${API_BASE}/v1/challenge`,
                        { signal: controller.signal },
                    );
                    if (!challengeRes.ok) throw new Error("Server Offline");
                    const { salt, seed, difficulty } =
                        await challengeRes.json();

                    // 2. Solve (The "Feather" math)
                    const nonce = await solveChallenge(salt, difficulty);
                    if (first_loading) {
                        document.getElementById("progress-bar").style.width =
                            "100%";
                        document.getElementById("loader-text").innerText =
                            "Voo autorizado! Aguardando a base de dados...";
                    }
                    // 3. Fetch Real-time Pulse
                    const pulseRes = await fetch(`${API_BASE}/v1/raw-pulse`, {
                        headers: {
                            "x-salt": salt,
                            "x-nonce": nonce.toString(),
                            "x-seed": seed,
                        },
                        signal: controller.signal,
                    });

                    if (!pulseRes.ok) throw new Error("Acesso negado");
                    const result = await pulseRes.json();

                    // We pick the top route for the simple demo card
                    renderUI(result);
                } catch (err) {
                    console.error(err);
                    document.getElementById("loader").innerHTML = `
                    <div class="canary-icon">🥀</div>
                    <p>O Canário cansou de esperar.</p>
                    <button class="error-btn" onclick="location.reload()">Tentar de Novo</button>
                `;
                } finally {
                    clearTimeout(timer);
                    let API_BASE = "https://backup.turinflow.com.br";
                }
            }

            /**
             * Render Data with 90-second Precision Logic
             */
            function renderUI(data) {
                // Hide Loader, Show Dashboard
                document.getElementById("loader").style.opacity = "0";
                document.getElementById("loader").style.display = "none";
                uiLoader(data);
                document.getElementById("dashboard").style.opacity = "100";
                document.getElementById("dashboard").style.display = "flex";
            }

            function uiLoader(data) {
                setTimeout(() => {
                    const namesContainer = document.getElementById("names2");

                    if (!namesContainer) {
                        throw new Error(
                            "Dashboard container #names2 not found",
                        );
                    }

                    if (!Array.isArray(data)) {
                        throw new Error("Invalid pulse data");
                    }

                    namesContainer.innerHTML = "";

                    const namesHtml = data
                        .map((route) => {
                            const routeName = String(
                                route.route_id ?? "Rota",
                            ).replace(/_/g, " ");

                            const delay =
                                route.delay == null || route.delay < 0
                                    ? "<0.01 min"
                                    : `${route.delay} minutos`;

                            const status =
                                route.status_label ?? "Dados indisponíveis";
                            const statusColor = getStatusColor(
                                route.stress_score,
                            );

                            return `
                                <div style="background-color: rgba(123, 136, 118, 0.11); backdrop-filter: blur(10px); border-radius: calc(100vw * 0.021); margin-inline: auto; justify-content: center; padding: 1rem; margin: 0.8rem 1rem 0.8rem 1rem; text-align: center; border: 1px solid #777" class="route-row">
                                    <span class="monospace align-right">
                                        Rota: ${routeName}
                                    </span>
                                    <br />
                                    <span class="monospace align-left">
                                        Atraso de ${delay} <br />
                                        <span style="color: ${statusColor}">
                                            (${status})
                                        </span>
                                    </span>
                                </div>
                            `;
                        })
                        .join("");

                    namesContainer.innerHTML = namesHtml;

                    const timeUpdated = document.getElementById("time_updated");

                    if (timeUpdated) {
                        timeUpdated.innerText = new Date().toLocaleTimeString(
                            "pt-BR",
                        );
                    }
                }, 400);
            }

            function getStatusColor(score) {
                if (score < 60) return "#72a88d";
                if (score > 100) return "#e63946";
                if (score > 95) return "#e69839";
                if (score > 85) return "#eba409";
                if (score > 75) return "#e6e639";
                if (score >= 60) return "#6d7c6e";
            }

            function reloadPage() {
                runCanaryEngine();
            }

            function firstLoading(loading) {
                let first_loading = true;
                document.getElementById("dashboard").style.opacity = "0";
                document.getElementById("dashboard").style.display = "none";
                runCanaryEngine(first_loading);
            }
            // Start the engine
            window.onload = firstLoading;
            setInterval(reloadPage, 4 * 60 * 1000);
        </script>
    </body>
</html>
