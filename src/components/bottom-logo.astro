---
import '../assets/styles/fonts.css';
import qr_code from '../assets/qr_code.png';
---

<div class="s1" style="padding-top: 4rem; font-size: calc(100vw * 0.159); line-height: calc(100vw * 0.159); color: #aaa; text-align: center; margin-bottom: 8px;">TURINFLOW</div>
<div class="g2" style="padding-bottom: 4rem; font-size: 21px; line-height: 21px; color: #111; margin-inline: auto; text-align: center;">Saia na hora certa.</div>

<div class="footer">      
        <div class="space-evenly" style="row-gap: 1rem; background-color: #888888; border-radius: 6px 6px 6px 6px; padding-left: 13px; padding-right: 13px; padding-top: 1.5rem; padding-bottom: 2rem;  display: flex; flex-direction: row; width: 93vw; flex-wrap: wrap; white-space: nowrap; justify-self: center;">
        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Aplicativo</div>
                <a class="button">Quem Somos > <br></a>
                <a class="button">Instalar > <br></a>
                <a class="button">Planos > <br></a>
                <a class="button" href="https://turinflow.com.br">Site > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Funcionalidades</div>
                <a class="button">Turin + Famílias > <br></a>
                <a class="button" href="https://turinflow.com.br/canarinho">Canarinho > <br></a>
                <a class="button" href="https://turinflow.com.br/transito">Trânsito > <br></a>
                <a class="button">Alertas > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Adicionais</div>
                <a class="button">Trânsito ao Vivo > <br></a>
                <a class="button">Defesa Civil > <br></a>
                <a class="button">Empresas > <br></a>
                     
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Compromissos</div>
                <a class="button">Ambiental > <br></a>
                <a class="button">Social > <br></a>
                <a class="button">Governança > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff; padding-bottom: 1rem;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Legal</div>
                <a class="button" href="https://turinflow.com.br/termos">Termos de Uso > <br></a>
                <a class="button" href="https://turinflow.com.br/privacidade">Privacidade > <br></a>
            </div>

            <div class="n2 mobile-1" style="color: #fff; height: auto;">
                <img style="width: 100%; height: auto; object-fit: contain;"src={qr_code.src} />
            </div>
        </div> 
        
        <div class="border-bottom title1 s1 UPPERCASE footer1" style="display: flex; color: #666; font-size: 1rem; font-weight: 500; line-height: 1.3rem; padding-top: 1rem; width: 95vw; ">
            <span class="title1 s1 bottom-1" style="font-size: 1rem; color: #666; font-weight: 500; line-height: 1.3rem;">Turin:&nbsp;Saia na hora certa.</span>
            <div class="title1 s1 desktop" style="padding-left: 4px; padding-right: 4px; gap: 26px; display: flex; justify-content: space-between; font-size: 1rem; color: #666; font-weight: 500; line-height: 1.3rem;">
                <a style="text-decoration: none; color: #666;" href="https://turinflow.com.br/status">Página de Status</a>
                <span>VTINC</span>
            </div>
        </div>
    </div>

    <style>
        .footer {
            width: 100%;
            vertical-align: bottom;
            background-color: #eee;
            transition: 0.45s ease-in-out;
            height: auto;
            padding-top: 4px;
        }
        
        .border-bottom {
            border-bottom: 1px solid #aaa;
            margin: 0.4rem;
            margin-bottom: 0.8rem;
            padding-bottom: 0.4rem;
            justify-content: center;
            
        }

        .footer-flex {flex: 0 0 38%;}
        .desktop {opacity: 0;  width: 0; height: 0}
        .mobile {opacity: 1}
        .row {flex-direction: column; row-gap: 0.6rem;}

        .mobile-1 {
            font-size: 18px; 
            line-height: 32px; 
            width: 35vw; 
            height: 165px;
        }

        .UPPERCASE {text-transform: uppercase;}
        .space-evenly {justify-content: space-between;}
        .footer1 {display: flex; justify-content: center;}
        .bottom-1 {text-align: center; justify-self: center;}

        .button {
            text-decoration: none;
            color: #ccc;
            border-radius: 5px;
            transition: 0.41s ease-in-out;
            padding-left: 0.3rem;
            padding-right: 0.5rem;
            padding-top: 0.1rem;
            padding-bottom: 0.1rem;
            line-height: 29px;
        }

        .button:hover {
            background-color: rgba(29, 59, 177, 0.4);
            transition: 0.41s ease-in-out;
        }

        @media (min-width: 768px) {
            .desktop {opacity: 1; width: auto;}
            .mobile {opacity: 0; display: none}
            .space-evenly {justify-content: space-evenly;}
            .padding-1 {margin-left: 1.5rem; width: 10rem;}
            .footer1 {display: block; padding-left: 0.4rem;}
            .mobile-1 {width: min(150px, 17%); height: 165px; min-width: 8rem;}
            .border-bottom {justify-content: space-between;}

            .frosted-glass {
                flex: 0 0 48%;
                margin: 0.6rem;
                border-radius: 8px;
                column-gap: 10rem;
                background-color: rgba(0, 0, 0, 0.14);
                opacity: 0.60;
                transition: 0.28s ease-in-out;
            }

            .frosted-glass:hover {
                background-color: var(--darker-1);
                opacity: 0.60;
                transition: 0.28s ease-in-out;
            }
        
            .row {
                flex-direction: row;
            }

            .footer-flex {
                flex: min(180px, 23%);
                flex-grow: 0;
                justify-content: flex-start;
            }

            .padding-1 {
                padding-bottom: 2rem;
                padding-right: 1rem;
            }
        }
    </style>