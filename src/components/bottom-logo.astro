---
import '../assets/styles/fonts.css';
---

<div class="s1" style="padding-top: 4rem; font-size: calc(100vw * 0.159); line-height: calc(100vw * 0.159); color: #aaa; text-align: center; margin-bottom: 8px;">TURINFLOW</div>
<div class="g2" style="padding-bottom: 4rem; font-size: 21px; line-height: 21px; color: #111; margin-inline: auto; text-align: center;">Simplesmente surpreendente.</div>

<div class="footer">      
        <div class="space-evenly" style="background-color: #959595; border-radius: 6px 6px 6px 6px; padding-left: 13px; padding-right: 13px; padding-top: 1.5rem; padding-bottom: 3rem;  display: flex; flex-direction: row; width: 93vw; flex-wrap: wrap; white-space: nowrap; justify-self: center; justify-content: space-between;">
        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Aplicativo</div>
                <a class="button">Quem Somos > <br></a>
                <a class="button">Visão Geral > <br></a>
                <a class="button">Plataforma > <br></a>
                <a class="button">Planos > <br></a>
                <a class="button" href="https://turinflow.com.br">Site > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Funcionalidades</div>
                <a class="button">Turin + Famílias > <br></a>
                <a class="button" href="https://turinflow.com.br/shield">Alertas Rápidas > <br></a>
                <a class="button">Mobilidade > <br></a> 
                <a class="button" href="https://turinflow.com.br/canarinho">Canarinho > <br></a>
                <a class="button" href="https://turinflow.com.br/transito">Trânsito > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Recursos</div>
                <a class="button">Documentação > <br></a>
                <a class="button">Atualizações > <br></a>
                <a class="button">FAQ (Ajuda) > <br></a> 
                <a class="button">Em breve > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Sistemas</div>
                <a class="button">Infraestrutura > <br></a>
                <a class="button">Segurança > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Suporte</div>
                <a class="button">Suporte/Contato > <br></a>
                <a class="button">Status do App > <br></a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff; padding-bottom: 1rem;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">Legal</div>
                <a class="button">Termos de Uso > <br></a>
                <a class="button">Privacidade > <br></a>
            </div>
        </div>  

        <div class="border-bottom title1 s1 UPPERCASE footer1" style="display: flex; color: #666; font-size: 1rem; font-weight: 500; line-height: 1.3rem; padding-top: 1rem; width: 95vw; ">
            <span class="title1 s1 bottom-1" style="font-size: 1rem; color: #666; font-weight: 500; line-height: 1.3rem;">Turin:&nbsp;Saia na hora certa.</span>
            <div class="title1 s1 desktop" style="padding-left: 4px; padding-right: 4px; gap: 26px; display: flex; justify-content: space-between; font-size: 1rem; color: #666; font-weight: 500; line-height: 1.3rem;">
                <a style="text-decoration: none;" href="https://vtinc.com.br">Página de Status</a>
                <span>VTINC</span>
            </div>
        </div>
    </div>

    <style>
        .footer {
            width: 100%;
            vertical-align: bottom;
            background-color: #eee;
            transition: 0.45s ease-in-out;
            height: auto;
            padding-top: 4px;
        }
        
        .border-bottom {
            border-bottom: 1px solid #aaa;
            margin: 0.4rem;
            margin-bottom: 0.8rem;
            padding-bottom: 0.4rem;
            justify-content: center;
            
        }

        .footer-flex {flex: 0 0 38%;}
        .desktop {opacity: 0;  width: 0; height: 0}
        .mobile {opacity: 1}
        .row {flex-direction: column; row-gap: 0.6rem;}
        .mobile-1 {font-size: 18px; line-height: 32px;}
        .UPPERCASE {text-transform: uppercase;}
        .space-evenly {justify-content: space-evenly;}
        .footer1 {display: flex; justify-content: center;}
        .bottom-1 {text-align: center; justify-self: center;}

        .button {
            text-decoration: none;
            color: #ccc;
            border-radius: 5px;
            transition: 0.41s ease-in-out;
            padding-left: 0.3rem;
            padding-right: 0.5rem;
            padding-top: 0.1rem;
            padding-bottom: 0.1rem;
            line-height: 29px;
        }

        .button:hover {
            background-color: rgba(29, 59, 177, 0.4);
            transition: 0.41s ease-in-out;
        }

        @media (min-width: 768px) {
            .desktop {opacity: 1; width: auto;}
            .mobile {opacity: 0; display: none}
            .space-evenly {justify-content: flex-start;}
            .padding-1 {margin-left: 1.5rem; width: 10rem;}
            .footer1 {display: block; padding-left: 0.4rem;}
            .mobile-1 {width: min(150px, 19%); min-width: 10rem;}
            .border-bottom {justify-content: space-between;}

            .frosted-glass {
                flex: 0 0 48%;
                margin: 0.6rem;
                border-radius: 8px;
                column-gap: 10rem;
                background-color: rgba(0, 0, 0, 0.14);
                opacity: 0.60;
                transition: 0.28s ease-in-out;
            }

            .frosted-glass:hover {
                background-color: var(--darker-1);
                opacity: 0.60;
                transition: 0.28s ease-in-out;
            }
        
            .row {
                flex-direction: row;
            }

            .footer-flex {
                flex: min(180px, 23%);
                flex-grow: 0;
                justify-content: flex-start;
            }

            .padding-1 {
                padding-bottom: 2rem;
                padding-right: 1rem;
            }
        }
    </style>