---
import "../assets/styles/fonts.css";
import qr_code from "../assets/qr_code.png";
---

<div
    class="s1 hover3 desktop"
    style="padding-top: 4rem; font-size: clamp(16px, calc(100vw * 0.109), 90px); line-height: clamp(15px, calc(100vw * 0.11), 90px); text-align: center; margin-bottom: 8px;"
>
    TURIN<span class="hover4">FLOW</span>
</div>

<div
    class="s1 hover3 mobile"
    style="padding-top: 4rem; font-size: clamp(16px, calc(100vw * 0.109), 90px); line-height: clamp(15px, calc(100vw * 0.11), 90px); text-align: center; margin-bottom: 8px;"
>
    TURIN
</div>
<div
    class="g2 hover3"
    style="font-weight: 350; color: #777; letter-spacing: 1px; padding-bottom: 4rem; font-size: 21px; line-height: 21px; margin-inline: auto; text-align: center;"
>
    Chegue com tranquilidade.
</div>

<footer class="footer">
    <div
        class="space-evenly dynamic-size"
        style="backdrop-filter: blur(12px); row-gap: 1rem; background-color: rgba(111, 129, 111, 1); border-radius: 6px 6px 6px 6px; padding-left: 1.5rem; padding-right: 1.5rem; padding-top: 1.5rem; display: flex; flex-direction: row; flex-wrap: wrap; white-space: nowrap; justify-self: center;"
    >
        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff;">
                Aplicativo
            </div>

            <a class="button">
                Quem Somos &gt;
                <br />
            </a>
            <a class="button">
                Instalar &gt; <br />
            </a>
            <a class="button" href="/precos">
                Preços &gt; <br />
            </a>
            <a class="button" href="/">
                Site &gt; <br />
            </a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">
                Recursos
            </div>
            <a class="button" href="/familias">
                Turin + Famílias &gt; <br />
            </a>
            <a class="button" href="/canarinho">
                Canarinho &gt; <br />
            </a>
            <a class="button" href="/transito">
                Trânsito &gt; <br />
            </a>
            <a class="button">
                Alertas &gt; <br />
            </a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">
                Adicionais
            </div>
            <a class="button" href="/transito-ao-vivo">
                Trânsito ao Vivo &gt; <br />
            </a>

            <a class="button" href="/rotinas">
                Rotinas &gt; <br />
            </a>
            <a class="button" href="/guardian">
                Defesa Civil &gt; <br />
            </a>
            <a class="button" href="/empresas">
                Empresas &gt; <br />
            </a>
        </div>

        <div class="n2 footer-flex mobile-1 padding1" style="color: #fff;">
            <div style="font-weight: 700; padding-left: 0.25rem; font-size: 19px; color: #fff">
                Legal
            </div>
            <a class="button">
                Termos de Uso &gt; <br />
            </a>
            <a class="button" href="/privacidade">
                Privacidade &gt; <br />
            </a>
        </div>

        <div
            class="n2 mobile-1 desktop image"
            style="color: #fff; height: auto;"
        >
            <img
                style="width: 100%; height: auto; object-fit: contain;"
                src={qr_code.src}
            />
        </div>

        <div class="mobile" style="height: 3rem; width: 100vw;"></div>
    </div>

    <div
        class="border-bottom title1 s1 UPPERCASE footer1"
        style="display: inline-flex; color: #666; font-size: 1rem; font-weight: 500; line-height: 1.3rem; padding-top: 1rem; width: 96vw; margin-inline: auto; max-height: 1.5rem;"
    >
        <span
            class="title1 s1 bottom-1"
            style="font-size: 1rem; color: #666; font-weight: 500; line-height: 1.3rem; padding-left: 0rem;"
        >
            Turin:&nbsp;Chegando com tranquilidade.
        </span>
        <div
            class="title1 s1 desktop"
            style="padding-left: 4px; padding-right: 0.4rem; gap: 26px; display: flex; justify-content: space-between; font-size: 1rem; color: #666; font-weight: 500; line-height: 1.3rem; height: auto;"
        >
            <a class="desktop" style="text-decoration: none; color: #666;">
                Página de Status
            </a>
            <span class="desktop">VTINC</span>
        </div>
    </div>
</footer>

<style>
    .mobile {
        display: block;
    }

    .hover3 {
        color: rgba(170, 170, 170, 0.85);
        transition: 0.31s ease-in-out;
    }
    .hover3:hover {
        color: rgba(111, 136, 136, 0.45);
        transition: 0.28s ease-in-out;
    }

    .hover4 {
        color: rgba(170, 170, 170, 0.85);
        text-decoration: line-through;
        text-decoration-thickness: 0.07em;
        text-decoration-color: rgba(170, 170, 170, 0.65);
        transition: 0.32s ease-in-out;
    }

    .hover4:hover {
        color: rgba(111, 136, 136, 0.45);
        text-decoration-color: rgba(111, 137, 137, 0.35);
        transition: 0.31s ease-in-out;
    }

    .footer {
        width: 100%;
        vertical-align: bottom;
        transition: 0.45s ease-in-out;
        height: auto;
        padding-top: 4px;
        display: inline-grid;
    }

    .border-bottom {
        border-bottom: 1px solid #aaa;
        margin: 0.4rem;
        margin-bottom: 0.8rem;
        padding-bottom: 0.4rem;
        justify-content: center;
    }

    .footer-flex {
        flex: 0 0 min(180px, 23%);
    }
    .desktop {
        display: none;
    }

    .mobile-1 {
        width: min(42vw, 160px);
        height: auto;
        min-height: 165px;
        min-width: 140px;
        padding-top: 0.35rem;
        padding-bottom: 0.35rem;
    }

    .image {
        padding-bottom: 2rem;
    }

    .UPPERCASE {
        text-transform: uppercase;
    }
    .space-evenly {
        justify-content: space-around;
    }
    .footer1 {
        display: flex;
        justify-content: center;
    }
    .bottom-1 {
        text-align: center;
        display: flex;
    }

    .button {
        text-decoration: none;
        color: #ccc;
        border-radius: 5px;
        transition: 0.41s ease-in-out;
        padding-left: 0.3rem;
        padding-right: 0.5rem;
        padding-top: 0.1rem;
        padding-bottom: 0.1rem;
        line-height: 29px;
        font-size: 17px;
    }

    .button:hover {
        background-color: rgba(29, 59, 177, 0.4);
        transition: 0.41s ease-in-out;
    }

    .dynamic-size {
        width: 83vw;
        padding-bottom: 0rem;
    }

    @media (min-width: 768px) {
        .desktop {
            width: auto;
            display: inherit;
        }

        .dynamic-size {
            width: 93vw;
            padding-bottom: 0.5rem;
        }

        .mobile {
            display: none;
        }
        .space-evenly {
            justify-content: space-evenly;
        }
        .footer1 {
            display: block;
            padding-left: 0.4rem;
        }
        .mobile-1 {
            width: min(150px, 17%);
            height: 165px;
            min-width: 8rem;
        }
        .border-bottom {
            justify-content: space-between;
        }

        .footer-flex {
            flex: min(180px, 23%);
            flex-grow: 0;
            justify-content: flex-start;
        }
    }
</style>
