---
import '../assets/styles/fonts.css';
---

<div class="s1" style="padding-top: 4rem; font-size: calc(100vw * 0.159); line-height: calc(100vw * 0.159); color: #aaa; text-align: center; margin-bottom: 8px;">TURINFLOW</div>
<div class="g2" style="padding-bottom: 4rem; font-size: 21px; line-height: 21px; color: #111; margin-inline: auto; text-align: center;">Não cai. Sem frescura.</div>

<footer class="footer">
  <div class="footer-cols">

    <!-- 1. Download -->
    <div class="footer-col">
      <div class="footer-title">Baixe o app</div>
      <a class="button" href="https://apps.apple.com/br/app/ID">Baixar na App Store</a>
      <a class="button" href="https://play.google.com/store/apps/details?id=ID">Baixar no Google Play</a>
      <div class="qr" role="img" aria-label="QR code para baixar o app">QR CODE</div>
      <div class="support">Atendimento: seg. a sex., 8h às 18h</div>
    </div>

    <!-- 2. O aplicativo -->
    <div class="footer-col">
      <div class="footer-title">O aplicativo</div>
      <a class="button" href="https://turinflow.com.br/transito">Trânsito</a>
      <a class="button" href="https://turinflow.com.br/canarinho">Canarinho</a>
      <a class="button" href="https://turinflow.com.br/shield">Alertas rápidos</a>
      <a class="button" href="https://turinflow.com.br/familias">Para famílias</a>
      <a class="button" href="https://turinflow.com.br/escolas">Para escolas</a>
    </div>

    <!-- 3. Ajuda -->
    <div class="footer-col">
      <div class="footer-title">Ajuda</div>
      <a class="button" href="https://turinflow.com.br/como-funciona">Como funciona</a>
      <a class="button" href="https://turinflow.com.br/faq">Perguntas frequentes</a>
      <a class="button" href="https://wa.me/5500000000000">Fale conosco (WhatsApp)</a>
      <a class="button" href="https://turinflow.com.br/status">Status do app</a>
    </div>

    <!-- 4. Legal -->
    <div class="footer-col">
      <div class="footer-title">Legal</div>
      <a class="button" href="https://turinflow.com.br/termos">Termos de Uso</a>
      <a class="button" href="https://turinflow.com.br/privacidade">Privacidade (LGPD)</a>
    </div>

  </div>

  <div class="border-bottom"></div>

  <div class="footer-bottom">
    <span>© 2025 Turin Sistemas LTDA · CNPJ 00.000.000/0001-00 · Todos os direitos reservados</span>
    <span class="made-in-brasil">Feito no Brasil 🇧🇷</span>
    <span class="social">
      <a class="button" href="https://facebook.com/SUA_PAGINA">Facebook</a>
      <a class="button" href="https://instagram.com/SUA_PAGINA">Instagram</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background-color: #eee;
    transition: background-color 0.45s ease-in-out;
    padding-top: 4px;
  }

  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    width: min(95vw, 1200px);
    margin-inline: auto;
    padding: 1rem;
  }

  .footer-col {
    flex: 0 0 45%;
    min-width: 10rem;
    padding: 1rem;
    box-sizing: border-box;
    color: #222;
    font-size: 18px;
    line-height: 32px;
  }

  .footer-title {
    font-weight: 700;
    padding-left: 0.25rem;
    font-size: 19px;
    color: #111;
  }

  .button {
    display: block;
    text-decoration: none;
    color: #333;
    border-radius: 5px;
    transition: 0.41s ease-in-out;
    padding: 0.1rem 0.5rem 0.1rem 0.3rem;
    line-height: 29px;
  }

  .button:hover {
    background-color: rgba(29, 59, 177, 0.4);
    color: #fff;
  }

  .qr {
    margin-top: 0.6rem;
    width: 120px;
    height: 120px;
    background: #fff;
    border: 1px solid #ccc;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    font-size: 12px;
    text-align: center;
  }

  .support {
    margin-top: 0.5rem;
    font-size: 15px;
    color: #555;
    padding-left: 0.3rem;
  }

  .border-bottom {
    border-bottom: 1px solid #aaa;
    margin: 0.4rem 1rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem 1.2rem;
    color: #888;
    font-size: 14px;
  }

  .footer-bottom .button { display: inline-block; color: #555; }

  @media (min-width: 768px) {
    .footer-cols { justify-content: flex-start; }
    .footer-col { flex: 0 0 min(200px, 23%); flex-grow: 0; }
  }
</style>